---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404: Sayfa Bulunamadı | YTÜ MİNT"
  description="Aradığınız sayfa bulunamadı. YTÜ MİNT ana sayfasına dönebilir veya diğer bağlantılarımıza göz atabilirsiniz."
>
  <div class="not-found-container">
    <div class="not-found-bg-glow" aria-hidden="true"></div>

    <div class="container">
      <div class="not-found-content">
        <!-- Badge -->
        <div class="section-badge">
          <span class="badge-dot"></span>
          Hata Kodu: 404
        </div>

        <!-- 404 Big Visual Indicator -->
        <div class="error-visual" aria-hidden="true">
          <span class="error-digit">4</span>
          <div class="error-leaf-box">
            <img src="/yaprak.png" alt="" class="error-leaf-img" />
          </div>
          <span class="error-digit">4</span>
        </div>

        <!-- Headings & Text -->
        <h1 class="not-found-title">Aradığınız Sayfa Bulunamadı</h1>
        <p class="not-found-desc">
          Ulaşmaya çalıştığınız adres değişmiş, silinmiş veya geçici olarak
          kullanım dışı olabilir. Aşağıdaki butonlardan ana sayfaya dönebilir veya
          aradığınız içeriği diğer sayfalarımızda bulabilirsiniz.
        </p>

        <!-- Main Action Buttons -->
        <div class="not-found-actions">
          <a href="/" class="btn btn-green not-found-btn">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Ana Sayfaya Dön
          </a>
          <a href="/contact" class="btn btn-outline not-found-btn">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Bize Ulaşın
          </a>
        </div>

        <!-- Helpful Navigation Cards -->
        <div class="quick-links-section">
          <h2 class="quick-links-title">Yardımcı Olabilecek Sayfalar</h2>
          <div class="quick-links-grid">
            <a href="/communities" class="quick-link-card">
              <div class="quick-link-icon-box">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="quick-link-text">
                <span class="quick-link-name">Topluluklarımız</span>
                <span class="quick-link-sub">Blockchain, Siber, HSD ve Deptron</span>
              </div>
              <span class="quick-link-arrow">→</span>
            </a>

            <a href="/events" class="quick-link-card">
              <div class="quick-link-icon-box">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <div class="quick-link-text">
                <span class="quick-link-name">Etkinliklerimiz</span>
                <span class="quick-link-sub">Hackathonlar, şirket gezileri & atölyeler</span>
              </div>
              <span class="quick-link-arrow">→</span>
            </a>

            <a href="/team" class="quick-link-card">
              <div class="quick-link-icon-box">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="quick-link-text">
                <span class="quick-link-name">Ekibimiz</span>
                <span class="quick-link-sub">MİNT Yönetim ve Liderlik Kadrosu</span>
              </div>
              <span class="quick-link-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found-container {
    position: relative;
    min-height: calc(100vh - 160px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 0 80px;
    background: var(--bg-main);
    overflow: hidden;
  }

  .not-found-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/mint-pattern.png");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .not-found-bg-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(97, 169, 93, 0.12) 0%,
      rgba(97, 169, 93, 0.04) 50%,
      transparent 70%
    );
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .not-found-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--green);
    display: inline-block;
  }

  /* Error Visual 404 */
  .error-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 16px 0 20px;
    user-select: none;
  }

  .error-digit {
    font-size: clamp(80px, 12vw, 130px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dark);
    text-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  }

  .error-leaf-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(70px, 10vw, 110px);
    height: clamp(70px, 10vw, 110px);
    background: linear-gradient(135deg, var(--green-light) 0%, #ffffff 100%);
    border: 2px solid var(--green-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px -4px rgba(97, 169, 93, 0.25);
    transform: rotate(-6deg);
    animation: gentleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes gentleFloat {
    0% {
      transform: translateY(0px) rotate(-6deg);
    }
    100% {
      transform: translateY(-8px) rotate(4deg);
    }
  }

  .error-leaf-img {
    width: 60%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(97, 169, 93, 0.3));
  }

  .not-found-title {
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .not-found-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 520px;
    margin-bottom: 28px;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .not-found-btn {
    padding: 10px 24px;
    font-size: 14px;
  }

  /* Quick Links */
  .quick-links-section {
    width: 100%;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .quick-links-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-subtle);
    margin-bottom: 16px;
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
  }

  .quick-link-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    text-align: left;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-sm);
  }

  .quick-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--green-border);
    box-shadow: var(--shadow-md);
    background: var(--white);
  }

  .quick-link-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--green-light);
    color: var(--green);
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .quick-link-card:hover .quick-link-icon-box {
    background: var(--green);
    color: var(--white);
  }

  .quick-link-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quick-link-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quick-link-sub {
    font-size: 11.5px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quick-link-arrow {
    color: var(--text-subtle);
    font-size: 16px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .quick-link-card:hover .quick-link-arrow {
    transform: translateX(3px);
    color: var(--green);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .quick-links-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .not-found-container {
      padding: 40px 0 60px;
      min-height: calc(100vh - 140px);
    }

    .not-found-actions {
      flex-direction: column;
      width: 100%;
    }

    .not-found-btn {
      width: 100%;
    }
  }
</style>
