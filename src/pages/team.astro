---
import Layout from "../layouts/Layout.astro";

const yonetimKurulu = [
  {
    ad: "Zeynep Cemre Çebitürk",
    unvan: "Başkan",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/zeynep-cemre-çebitürk",
    foto: "/ekip-cemre.webp",
  },
  {
    ad: "Melike Nur Bakırcı",
    unvan: "Başkan Yardımcısı",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/melike-bakirci/",
    foto: "/ekip-melike.webp",
  },
  {
    ad: "Ceren Şengüler",
    unvan: "Sekreter - Organizasyon Birimi Koordinatörü",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/ceren-şengüler",
    foto: "/ekip-ceren.webp",
  },
  {
    ad: "Batuhan Yılmaz",
    unvan: "Sayman",
    bolum: "Bilgisayar Mühendisliği",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/batuhan-yılmaz-5a4027324/",
    foto: "/ekip-batuhan.webp",
  },
  {
    ad: "Duygu Tunç",
    unvan: "Sponsorluk Koordinatörü",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/duygu-tunç-4bb190278",
    foto: "/ekip-duygu.webp",
  },
  {
    ad: "Arda Türk",
    unvan: "Sosyal Medya Koordinatörü",
    bolum: "İktisat",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/arda-türk-32482523a",
    foto: "/ekip-arda.webp",
  },
  {
    ad: "Nisa Hamarat",
    unvan: "Sosyal Medya Koordinatör Yardımcısı",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/nisa-hamarat-246792361",
    foto: "/ekip-nisa.webp",
  },
];

const denetimKurulu = [
  {
    ad: "Sude Naz Akkaya",
    unvan: "Denetim Kurulu Başkanı",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/sudenazakkaya/",
    foto: "/ekip-sude.webp",
  },
  {
    ad: "Nisanur Koçak",
    unvan: "Denetim Kurulu Başkan Yardımcısı",
    bolum: "Endüstri Mühendisliği",
    sinif: "",
    linkedin: "https://www.linkedin.com/in/nisanur-koçak-9b0328285/",
    foto: "/ekip-nisanur.webp",
  },
  {
    ad: "Zehra Nur Özmen",
    unvan: "Denetim Kurulu Üyesi",
    bolum: "İşletme",
    sinif: "",
    linkedin: "https://www.linkedin.com/in/zehranurozmen/",
    foto: "/ekip-zehra.webp",
  },
];
---

<Layout
  title="Ekibimiz | YTÜ MİNT"
  description="YTÜ MİNT ekibini tanıyın | yönetim kurulu ve denetim kurulu olarak topluluğumuzu yöneten öğrenci liderler."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Ekibimiz</h1>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">7</div>
            <div class="stat-label">Yönetim Kurulu</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">3</div>
            <div class="stat-label">Denetim Kurulu</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yönetim Kurulu -->
  <section class="team-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Yönetim Kurulu</h2>
        <p class="section-description">
          Topluluğumuzun stratejik yönetiminden ve günlük operasyonlarından
          sorumlu liderler.
        </p>
      </div>

      <div class="team-grid">
        {
          yonetimKurulu.map((uye) => (
            <div class="team-card">
              <div class="team-card-header">
                <div class="team-avatar">
                  {uye.foto ? (
                    <img
                      src={uye.foto}
                      alt={uye.ad}
                      class="team-avatar-img"
                      loading="lazy"
                    />
                  ) : (
                    "👤"
                  )}
                </div>
                {uye.linkedin && (
                  <a
                    href={uye.linkedin}
                    class="team-linkedin"
                    aria-label={`${uye.ad} LinkedIn Profili`}
                    target="_blank"
                    rel="noopener"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  </a>
                )}
              </div>
              <div class="team-info-block">
                <h3 class="team-name">{uye.ad}</h3>
                <div class="team-role">{uye.unvan}</div>
              </div>
              {(uye.bolum || uye.sinif) && (
                <div class="team-meta">
                  {uye.bolum && (
                    <span class="team-meta-item">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                      </svg>
                      {uye.bolum}
                    </span>
                  )}
                  {uye.sinif && (
                    <span class="team-meta-item">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <rect
                          x="3"
                          y="4"
                          width="18"
                          height="18"
                          rx="2"
                          ry="2"
                        />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                      </svg>
                      {uye.sinif}
                    </span>
                  )}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Denetim Kurulu -->
  <section class="team-section team-section--audit">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Denetim Kurulu</h2>
        <p class="section-description">
          Topluluğumuzun faaliyetlerini ve mali şeffaflığını denetleyen bağımsız
          kurul üyelerimiz.
        </p>
      </div>

      <div class="team-grid team-grid--audit">
        {
          denetimKurulu.map((uye) => (
            <div class="team-card">
              <div class="team-card-header">
                <div class="team-avatar">
                  {uye.foto ? (
                    <img
                      src={uye.foto}
                      alt={uye.ad}
                      class="team-avatar-img"
                      loading="lazy"
                    />
                  ) : (
                    "👤"
                  )}
                </div>
                {uye.linkedin && (
                  <a
                    href={uye.linkedin}
                    class="team-linkedin"
                    aria-label={`${uye.ad} LinkedIn Profili`}
                    target="_blank"
                    rel="noopener"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  </a>
                )}
              </div>
              <div class="team-info-block">
                <h3 class="team-name">{uye.ad}</h3>
                <div class="team-role">{uye.unvan}</div>
              </div>
              {(uye.bolum || uye.sinif) && (
                <div class="team-meta">
                  {uye.bolum && (
                    <span class="team-meta-item">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                      </svg>
                      {uye.bolum}
                    </span>
                  )}
                  {uye.sinif && (
                    <span class="team-meta-item">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <rect
                          x="3"
                          y="4"
                          width="18"
                          height="18"
                          rx="2"
                          ry="2"
                        />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                      </svg>
                      {uye.sinif}
                    </span>
                  )}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="join-section">
    <div class="container">
      <div class="join-inner">
        <div>
          <h2 class="join-title">Sen de Ekibe Katıl</h2>
          <p class="join-desc">
            Yeni dönem kurul ve koordinatörlük başvuruları dönem başında
            açılıyor. Liderlik deneyimi kazanmak ve MİNT'i birlikte büyütmek
            istiyorsan aramıza katıl.
          </p>
        </div>
        <a href="/contact" class="btn btn-green join-btn">Başvur →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Page Hero ──────────────────────────────────────────────── */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/mint-pattern.webp');
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97, 169, 93, 0.25), transparent);
    z-index: 1;
  }

  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  .page-hero-stats {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .stat-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 12px 18px;
    text-align: center;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
  }

  .stat-number {
    font-size: 24px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 2px;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Team Sections ──────────────────────────────────────────── */
  .team-section {
    padding: 48px 0 40px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .team-section--audit {
    padding: 48px 0 64px;
    background: var(--bg-subtle);
    position: relative;
    overflow: hidden;
  }

  .team-section--audit::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97, 169, 93, 0.25), transparent);
  }

  /* ── Team Grid ──────────────────────────────────────────────── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .team-grid--audit {
    grid-template-columns: repeat(3, 1fr);
  }

  /* ── Team Card ──────────────────────────────────────────────── */
  .team-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px 18px;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .team-section--audit .team-card {
    background: var(--bg-main);
  }
  .team-card:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.35);
    box-shadow: var(--shadow-hover);
  }

  .team-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .team-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--bg-muted);
    border: 2px solid rgba(97, 169, 93, 0.2);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    flex-shrink: 0;
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .team-card:hover .team-avatar {
    border-color: var(--green);
    transform: scale(1.04);
    box-shadow: 0 4px 14px rgba(97, 169, 93, 0.2);
  }

  .team-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    border-radius: 50%;
  }

  .team-linkedin {
    width: 30px;
    height: 30px;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .team-linkedin:hover {
    background: #0077b5;
    color: var(--white);
    border-color: #0077b5;
    transform: translateY(-2px);
    box-shadow: 0 3px 8px rgba(0, 119, 181, 0.25);
  }

  .team-info-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .team-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    line-height: 1.3;
  }

  .team-role {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--green-text);
    line-height: 1.35;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 10px;
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
  }

  .team-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .team-meta-item svg {
    flex-shrink: 0;
    color: var(--text-subtle);
  }

  /* ── Join CTA ───────────────────────────────────────────────── */
  .join-section {
    padding: 30px 0 60px;
    background: var(--bg-main);
  }
  .join-inner {
    background: var(--dark);
    color: var(--white);
    border-radius: var(--radius-md);
    padding: 36px 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    box-shadow: var(--shadow-md);
  }
  .join-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--white);
  }
  .join-desc {
    font-size: 14px;
    color: #94a3b8;
    line-height: 1.55;
    max-width: 480px;
  }
  .join-btn {
    flex-shrink: 0;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .team-grid,
    .team-grid--audit {
      grid-template-columns: repeat(2, 1fr);
    }
    .join-inner {
      flex-direction: column;
      padding: 32px 24px;
      text-align: center;
    }
    .page-hero-stats {
      gap: 12px;
    }
  }
  @media (max-width: 640px) {
    .team-grid,
    .team-grid--audit {
      grid-template-columns: 1fr;
    }
    .page-hero-inner {
      flex-direction: column;
    }
    .page-hero-stats {
      width: 100%;
      justify-content: space-between;
    }
    .join-inner {
      padding: 24px 18px;
    }
  }
</style>
