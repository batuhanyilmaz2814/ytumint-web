---
import Layout from '../layouts/Layout.astro';

const yonetimKurulu = [
  {
    ad: "Ahmet Yılmaz",
    unvan: "Başkan",
    bolum: "Bilgisayar Mühendisliği",
    sinif: "4. Sınıf",
    linkedin: "#",
    emoji: "👨‍💻",
  },
  {
    ad: "Zeynep Kara",
    unvan: "Genel Sekreter",
    bolum: "Matematik Mühendisliği",
    sinif: "3. Sınıf",
    linkedin: "#",
    emoji: "👩‍🔬",
  },
  {
    ad: "Mert Demir",
    unvan: "Etkinlik Koordinatörü",
    bolum: "Endüstri Mühendisliği",
    sinif: "3. Sınıf",
    linkedin: "#",
    emoji: "🧑‍🎓",
  },
  {
    ad: "Elif Şahin",
    unvan: "Teknik Lider",
    bolum: "Bilgisayar Mühendisliği",
    sinif: "2. Sınıf",
    linkedin: "#",
    emoji: "👩‍💻",
  },
  {
    ad: "Can Özkan",
    unvan: "Kariyer & Sponsorluk",
    bolum: "İşletme Mühendisliği",
    sinif: "4. Sınıf",
    linkedin: "#",
    emoji: "🧑‍💼",
  },
  {
    ad: "Selin Arslan",
    unvan: "Matematik Lideri",
    bolum: "Matematik Mühendisliği",
    sinif: "4. Sınıf",
    linkedin: "#",
    emoji: "👩‍🏫",
  },
];

const denetimKurulu = [
  {
    ad: "Emre Yıldız",
    unvan: "Denetim Kurulu Başkanı",
    bolum: "Matematik Mühendisliği",
    sinif: "4. Sınıf",
    linkedin: "#",
    emoji: "🧑‍⚖️",
  },
  {
    ad: "Ayşe Güneş",
    unvan: "Denetim Kurulu Üyesi",
    bolum: "Bilgisayar Mühendisliği",
    sinif: "3. Sınıf",
    linkedin: "#",
    emoji: "👩‍💼",
  },
  {
    ad: "Burak Çetin",
    unvan: "Denetim Kurulu Üyesi",
    bolum: "Endüstri Mühendisliği",
    sinif: "3. Sınıf",
    linkedin: "#",
    emoji: "👨‍💼",
  },
];
---

<Layout
  title="Ekibimiz — YTU MINT"
  description="YTU MINT ekibini tanıyın — yönetim kurulu ve denetim kurulu olarak topluluğumuzu yöneten öğrenci liderler."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Ekibimiz</h1>
          <p class="page-hero-desc">
            YTU MINT'i yöneten, geliştiren ve büyüten öğrenci liderlerimizle tanışın.
            Her biri kendi alanında uzmanlaşmış, tutkulu bir ekip.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">9</div>
            <div class="stat-label">Ekip Üyesi</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">6</div>
            <div class="stat-label">Yönetim Kurulu</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">3</div>
            <div class="stat-label">Denetim Kurulu</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yönetim Kurulu -->
  <section class="team-section">
    <div class="container">
      <div class="section-header">
        <div class="section-chip-wrap">
          <span class="section-chip">Yönetim</span>
        </div>
        <h2 class="section-label">Yönetim Kurulu</h2>
        <p class="section-description">
          Topluluğumuzun stratejik yönetiminden ve günlük operasyonlarından sorumlu liderler.
        </p>
      </div>

      <div class="team-grid">
        {yonetimKurulu.map((uye, i) => (
          <div class:list={["team-card", { "team-card--featured": i === 0 }]}>
            <div class="team-card-header">
              <div class="team-avatar">{uye.emoji}</div>
              <a href={uye.linkedin} class="team-linkedin" aria-label="LinkedIn" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                  <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                  <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
                </svg>
              </a>
            </div>
            <div class="team-info-block">
              <div class="team-name">{uye.ad}</div>
              <div class="team-role">{uye.unvan}</div>
            </div>
            <div class="team-meta">
              <span class="team-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                {uye.bolum}
              </span>
              <span class="team-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {uye.sinif}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Denetim Kurulu -->
  <section class="team-section team-section--audit">
    <div class="container">
      <div class="section-header">
        <div class="section-chip-wrap">
          <span class="section-chip section-chip--dark">Denetim</span>
        </div>
        <h2 class="section-label">Denetim Kurulu</h2>
        <p class="section-description">
          Topluluğumuzun faaliyetlerini ve mali işlemlerini denetleyen bağımsız kurul.
        </p>
      </div>

      <div class="team-grid team-grid--audit">
        {denetimKurulu.map((uye, i) => (
          <div class:list={["team-card team-card--audit", { "team-card--audit-featured": i === 0 }]}>
            <div class="team-card-header">
              <div class="team-avatar">{uye.emoji}</div>
              <a href={uye.linkedin} class="team-linkedin" aria-label="LinkedIn" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                  <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                  <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
                </svg>
              </a>
            </div>
            <div class="team-info-block">
              <div class="team-name">{uye.ad}</div>
              <div class="team-role">{uye.unvan}</div>
            </div>
            <div class="team-meta">
              <span class="team-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                {uye.bolum}
              </span>
              <span class="team-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {uye.sinif}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="join-section">
    <div class="container">
      <div class="join-inner">
        <div>
          <h2 class="join-title">Sen de Ekibe Katıl</h2>
          <p class="join-desc">
            Yeni dönem yönetim kurulu başvuruları Eylül ayında açılıyor.
            Liderlik deneyimi kazanmak ve MINT'i birlikte büyütmek istiyorsan başvurunu yap.
          </p>
        </div>
        <a href="/contact" class="btn btn-dark join-btn">Başvur →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Page Hero ──────────────────────────────────────────────── */
  .page-hero {
    padding: 80px 0 60px;
    background: var(--gray);
    border-bottom: 1px solid var(--dark);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    margin-bottom: 20px;
    background: var(--green);
    display: inline-block;
    padding: 0 10px;
    border-radius: 8px;
  }
  .page-hero-desc { font-size: 18px; line-height: 1.7; color: #555; max-width: 560px; }
  .page-hero-stats { display: flex; gap: 24px; flex-shrink: 0; }
  .stat-card {
    background: var(--white);
    border: 1px solid var(--dark);
    border-radius: 20px;
    padding: 28px 32px;
    text-align: center;
    box-shadow: 4px 4px 0 var(--dark);
  }
  .stat-number { font-size: 42px; font-weight: 700; color: var(--dark); line-height: 1; margin-bottom: 6px; }
  .stat-label { font-size: 14px; color: #666; }

  /* ── Section chip ───────────────────────────────────────────── */
  .section-chip-wrap { margin-bottom: 10px; }
  .section-chip {
    display: inline-block;
    background: var(--green);
    color: var(--dark);
    font-size: 13px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 20px;
    border: 1px solid var(--dark);
    letter-spacing: 0.3px;
  }
  .section-chip--dark {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
  }

  /* ── Team Sections ──────────────────────────────────────────── */
  .team-section { padding: 80px 0 40px; }
  .team-section--audit {
    padding: 60px 0 80px;
    background: var(--gray);
  }

  /* ── Team Grid ──────────────────────────────────────────────── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .team-grid--audit {
    grid-template-columns: repeat(3, 1fr);
    max-width: 900px;
  }

  /* ── Team Card ──────────────────────────────────────────────── */
  .team-card {
    border: 1px solid var(--dark);
    border-radius: 28px;
    padding: 32px 28px;
    box-shadow: 4px 4px 0 var(--dark);
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .team-card:hover { transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--dark); }
  .team-card--featured { background: var(--dark); }
  .team-card--audit { background: var(--white); }
  .team-card--audit-featured { background: var(--dark); }

  .team-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .team-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px solid var(--dark);
    background: var(--gray);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    flex-shrink: 0;
  }
  .team-card--featured .team-avatar,
  .team-card--audit-featured .team-avatar {
    border-color: var(--green);
    background: rgba(185,255,102,0.1);
  }

  .team-linkedin {
    width: 36px;
    height: 36px;
    background: var(--dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .team-linkedin:hover { opacity: 0.75; transform: scale(1.1); }

  .team-info-block {}
  .team-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 4px;
  }
  .team-card--featured .team-name,
  .team-card--audit-featured .team-name { color: var(--white); }

  .team-role {
    font-size: 14px;
    font-weight: 600;
    color: #888;
  }
  .team-card--featured .team-role,
  .team-card--audit-featured .team-role { color: var(--green); }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid rgba(25,26,35,0.1);
  }
  .team-card--featured .team-meta,
  .team-card--audit-featured .team-meta { border-top-color: rgba(255,255,255,0.15); }

  .team-meta-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: #666;
  }
  .team-card--featured .team-meta-item,
  .team-card--audit-featured .team-meta-item { color: rgba(255,255,255,0.6); }
  .team-card--featured .team-meta-item svg,
  .team-card--audit-featured .team-meta-item svg { stroke: rgba(255,255,255,0.5); }

  /* ── Join CTA ───────────────────────────────────────────────── */
  .join-section { padding: 40px 0 80px; }
  .join-inner {
    background: var(--green);
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 60px 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    box-shadow: 5px 5px 0 var(--dark);
  }
  .join-title { font-size: 36px; font-weight: 600; margin-bottom: 12px; }
  .join-desc { font-size: 18px; color: #333; line-height: 1.6; max-width: 560px; }
  .join-btn { flex-shrink: 0; }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .team-grid--audit { grid-template-columns: repeat(3, 1fr); }
    .join-inner { flex-direction: column; padding: 50px 40px; }
    .page-hero-stats { gap: 16px; }
    .stat-card { padding: 20px 22px; }
    .stat-number { font-size: 32px; }
  }
  @media (max-width: 640px) {
    .team-grid { grid-template-columns: 1fr; }
    .team-grid--audit { grid-template-columns: 1fr; max-width: 100%; }
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; justify-content: space-between; }
    .join-inner { padding: 40px 28px; }
  }
</style>
