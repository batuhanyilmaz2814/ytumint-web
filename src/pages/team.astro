---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const rawYonetimKurulu = [
  {
    ad: "Zeynep Cemre Çebitürk",
    unvan: "Başkan",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/zeynep-cemre-çebitürk",
    github: "https://github.com/zcemrecebiturk",
    foto: "/team/ekip-cemre.webp",
  },
  {
    ad: "Melike Nur Bakırcı",
    unvan: "Başkan Yardımcısı",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/melike-bakirci/",
    github: "https://github.com/melike-bakirci",
    foto: "/team/ekip-melike.webp",
  },
  {
    ad: "Ceren Şengüler",
    unvan: "Sekreter - Org. Koordinaötrü",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/ceren-şengüler",
    foto: "/team/ekip-ceren.webp",
  },
  {
    ad: "Batuhan Yılmaz",
    unvan: "Sayman",
    bolum: "Bilgisayar Mühendisliği",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/batuhan-yılmaz-5a4027324/",
    github: "https://github.com/batuhanyilmaz2814",
    foto: "/team/ekip-batuhan.webp",
  },
  {
    ad: "Duygu Tunç",
    unvan: "Sponsorluk Koordinatörü",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/duygu-tunç-4bb190278",
    github: "https://github.com/dygtnc",
    foto: "/team/ekip-duygu.webp",
  },
  {
    ad: "Arda Türk",
    unvan: "Sosyal Medya Koordinatörü",
    bolum: "İktisat",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/arda-türk-32482523a",
    foto: "/team/ekip-arda.webp",
  },
  {
    ad: "Nisa Hamarat",
    unvan: "Sosyal Medya Koordinatör Yardımcısı",
    bolum: "İstatistik",
    sinif: "2. Sınıf",
    linkedin: "https://www.linkedin.com/in/nisa-hamarat-246792361",
    foto: "/team/ekip-nisa.webp",
  },
];

const rawDenetimKurulu = [
  {
    ad: "Sude Naz Akkaya",
    unvan: "Denetim Kurulu Başkanı",
    bolum: "İstatistik",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/sudenazakkaya/",
    foto: "/team/ekip-sude.webp",
  },
  {
    ad: "Nisanur Koçak",
    unvan: "Denetim Kurulu Başkan Yardımcısı",
    bolum: "Endüstri Mühendisliği",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/nisanur-koçak-9b0328285/",
    foto: "/team/ekip-nisanur.webp",
  },
  {
    ad: "Zehra Nur Özmen",
    unvan: "Denetim Kurulu Üyesi",
    bolum: "İşletme",
    sinif: "3. Sınıf",
    linkedin: "https://www.linkedin.com/in/zehranurozmen/",
    foto: "/team/ekip-zehra.webp",
  },
];
const yonetimKurulu = rawYonetimKurulu.filter(
  (uye) => uye.foto && uye.foto.trim() !== "",
);

const denetimKurulu = rawDenetimKurulu.filter(
  (uye) => uye.foto && uye.foto.trim() !== "",
);

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://ytumint.org";

const allMembers = [...yonetimKurulu, ...denetimKurulu];

const teamJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Ekibimiz | YTÜ MİNT",
  description:
    "YTÜ MİNT ekibini tanıyın | yönetim kurulu ve denetim kurulu olarak topluluğumuzu yöneten öğrenci liderler.",
  url: `${siteUrl}/team`,
  mainEntity: {
    "@type": "ItemList",
    name: "YTÜ MİNT Yönetim ve Denetim Kurulu Üyeleri",
    itemListElement: allMembers.map((uye, index) => {
      const sameAs = [uye.linkedin, uye.github].filter(Boolean) as string[];
      const fotoUrl = uye.foto.startsWith("http")
        ? uye.foto
        : `${siteUrl}${uye.foto}`;

      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "Person",
          name: uye.ad,
          jobTitle: uye.unvan,
          image: fotoUrl,
          worksFor: {
            "@type": "Organization",
            name: "YTÜ MİNT",
            url: `${siteUrl}/`,
          },
          ...(sameAs.length > 0 ? { sameAs } : {}),
        },
      };
    }),
  },
};
---

<Layout
  title="Ekibimiz | YTÜ MİNT"
  description="YTÜ MİNT ekibini tanıyın | yönetim kurulu ve denetim kurulu olarak topluluğumuzu yöneten öğrenci liderler."
  keywords="YTÜ MİNT ekibi, yönetim kurulu, denetim kurulu, öğrenci liderleri, YTÜ kulüp yönetimi, multidisipliner inovasyon teknolojileri ekibi"
  jsonLd={teamJsonLd}
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Ekibimiz</h1>
          <Breadcrumb currentPage="Ekibimiz" />
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">{yonetimKurulu.length}</div>
            <div class="stat-label">Yönetim Kurulu</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">{denetimKurulu.length}</div>
            <div class="stat-label">Denetim Kurulu</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yönetim Kurulu -->
  <section class="team-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Yönetim Kurulu</h2>
      </div>

      <div class="team-grid">
        {
          yonetimKurulu.map((uye) => (
            <div class="team-card">
              <div class="team-avatar">
                <img
                  src={uye.foto}
                  alt={`${uye.ad} - ${uye.unvan}`}
                  class="team-avatar-img"
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="team-info-block">
                <h3 class="team-name">{uye.ad}</h3>
                <div class="team-role">{uye.unvan}</div>
                {(uye.github || uye.linkedin) && (
                  <div class="team-socials">
                    {uye.github && (
                      <a
                        href={uye.github}
                        class="team-social-btn team-social-btn--github"
                        aria-label={`${uye.ad} GitHub Profili`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="GitHub"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                      </a>
                    )}
                    {uye.linkedin && (
                      <a
                        href={uye.linkedin}
                        class="team-social-btn team-social-btn--linkedin"
                        aria-label={`${uye.ad} LinkedIn Profili`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="LinkedIn"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                          <rect x="2" y="9" width="4" height="12" />
                          <circle cx="4" cy="4" r="2" />
                        </svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
              {(uye.bolum || uye.sinif) && (
                <div class="team-meta">
                  <span class="team-meta-item">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                      <path d="M6 12v5c3 3 9 3 12 0v-5" />
                    </svg>
                    {[uye.bolum, uye.sinif].filter(Boolean).join(" ")}
                  </span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Denetim Kurulu -->
  <section class="team-section team-section--audit">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Denetim Kurulu</h2>
      </div>

      <div class="team-grid team-grid--audit">
        {
          denetimKurulu.map((uye) => (
            <div class="team-card">
              <div class="team-avatar">
                <img
                  src={uye.foto}
                  alt={`${uye.ad} - ${uye.unvan}`}
                  class="team-avatar-img"
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="team-info-block">
                <h3 class="team-name">{uye.ad}</h3>
                <div class="team-role">{uye.unvan}</div>
                {(uye.github || uye.linkedin) && (
                  <div class="team-socials">
                    {uye.github && (
                      <a
                        href={uye.github}
                        class="team-social-btn team-social-btn--github"
                        aria-label={`${uye.ad} GitHub Profili`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="GitHub"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                      </a>
                    )}
                    {uye.linkedin && (
                      <a
                        href={uye.linkedin}
                        class="team-social-btn team-social-btn--linkedin"
                        aria-label={`${uye.ad} LinkedIn Profili`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="LinkedIn"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                          <rect x="2" y="9" width="4" height="12" />
                          <circle cx="4" cy="4" r="2" />
                        </svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
              {(uye.bolum || uye.sinif) && (
                <div class="team-meta">
                  <span class="team-meta-item">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                      <path d="M6 12v5c3 3 9 3 12 0v-5" />
                    </svg>
                    {[uye.bolum, uye.sinif].filter(Boolean).join(" ")}
                  </span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Page Hero ──────────────────────────────────────────────── */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/brand/mint-pattern.webp");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  .page-hero-stats {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .stat-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 12px 18px;
    text-align: center;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
  }

  .stat-number {
    font-size: 24px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 2px;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Team Sections ──────────────────────────────────────────── */
  .section-header {
    margin-bottom: 24px;
  }

  .team-section {
    padding: 48px 0 40px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .team-section--audit {
    padding: 48px 0 80px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  /* ── Team Grid ──────────────────────────────────────────────── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .team-grid--audit {
    grid-template-columns: repeat(4, 1fr);
  }

  /* ── Team Card ──────────────────────────────────────────────── */
  .team-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px 16px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    gap: 10px;
    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.03),
      0 1px 2px rgba(15, 23, 42, 0.02);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .team-card:hover {
    transform: translateY(-2px);
    border-color: rgba(97, 169, 93, 0.25);
    box-shadow: 0 8px 16px -4px rgba(15, 23, 42, 0.05);
  }

  :global([data-theme="dark"]) .team-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.5);
  }

  .team-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--bg-muted);
    padding: 3px;
    border: 2px solid rgba(97, 169, 93, 0.25);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    z-index: 1;
    transition: border-color 0.25s ease;
  }

  .team-card:hover .team-avatar {
    border-color: rgba(97, 169, 93, 0.5);
  }

  .team-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .team-card:hover .team-avatar-img {
    transform: scale(1.03);
  }

  .team-info-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3px;
    position: relative;
    z-index: 1;
    width: 100%;
    flex: 1;
    justify-content: flex-start;
  }

  .team-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .team-role {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--green-text);
    line-height: 1.35;
    margin: 0;
    max-width: 210px;
  }

  .team-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
    height: 28px;
    z-index: 1;
  }

  .team-social-btn {
    width: 28px;
    height: 28px;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .team-social-btn--linkedin:hover {
    background: #0077b5;
    color: #ffffff;
    border-color: #0077b5;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 119, 181, 0.25);
  }

  .team-social-btn--github:hover {
    background: #24292e;
    color: #ffffff;
    border-color: #24292e;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="dark"]) .team-social-btn--github:hover {
    background: #ffffff;
    color: #0f172a;
    border-color: #ffffff;
    box-shadow: 0 4px 10px rgba(255, 255, 255, 0.2);
  }

  .team-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 10px;
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    position: relative;
    z-index: 1;
    width: 100%;
  }

  :global([data-theme="dark"]) .team-meta {
    border-top-color: rgba(255, 255, 255, 0.04);
  }

  .team-meta-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .team-meta-item svg {
    flex-shrink: 0;
    color: var(--green);
    opacity: 0.85;
  }

  /* ── Responsive ─────────────────────────────────────────────── */

  /* Geniş tablet: 1180px ve altı — 3 kolon */
  @media (max-width: 1180px) {
    .team-grid,
    .team-grid--audit {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  /* Tablet: 1024px ve altı */
  @media (max-width: 1024px) {
    .team-section {
      padding: 40px 0 32px;
    }

    .team-section--audit {
      padding: 40px 0 64px;
    }
  }

  /* Küçük tablet: 768px ve altı — 2 kolon */
  @media (max-width: 768px) {
    .page-hero {
      min-height: 120px;
      padding: 32px 0;
    }

    .page-hero-inner {
      gap: 20px;
    }

    .page-hero-title {
      font-size: 26px;
    }

    .page-hero-stats {
      gap: 10px;
    }

    .stat-card {
      padding: 10px 16px;
    }

    .stat-number {
      font-size: 20px;
    }

    .stat-label {
      font-size: 11.5px;
    }

    .team-section {
      padding: 32px 0 24px;
    }

    .team-section--audit {
      padding: 32px 0 56px;
    }

    .section-header {
      margin-bottom: 18px;
    }

    .team-grid,
    .team-grid--audit {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .team-card {
      padding: 18px 14px 14px;
    }

    .team-avatar {
      width: 84px;
