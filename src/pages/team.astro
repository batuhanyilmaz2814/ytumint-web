---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Ekibimiz — YTU MINT"
  description="YTU MINT ekibini tanıyın — topluluğumuzu yöneten öğrenci liderler, teknik ekip ve danışmanlar."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Ekibimiz</h1>
          <p class="page-hero-desc">
            YTU MINT'i yöneten, geliştiren ve büyüten öğrenci liderlerimizle tanışın.
            Her biri kendi alanında uzmanlaşmış, tutkulu bir ekip.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">12</div>
            <div class="stat-label">Aktif Yönetici</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">3</div>
            <div class="stat-label">Danışman</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">50+</div>
            <div class="stat-label">Gönüllü</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="team-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-label">Yönetim Kurulu</h2>
        <p class="section-description">
          Topluluğumuzun stratejik yönetiminden ve günlük operasyonlarından sorumlu liderler.
        </p>
      </div>

      <div class="team-grid">

        <div class="team-card team-card--featured">
          <div class="team-card-top">
            <div class="team-avatar">👨‍💻</div>
            <div class="team-info">
              <div class="team-name">Ahmet Yılmaz</div>
              <div class="team-role">Başkan</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">Bilgisayar Mühendisliği 4. sınıf öğrencisi. Makine öğrenmesi ve doğal dil işleme alanlarında araştırma yapıyor. MINT'i 3 yıldır yönetiyor.</p>
          <div class="team-skills">
            <span>Python</span><span>ML</span><span>NLP</span>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-top">
            <div class="team-avatar">👩‍🔬</div>
            <div class="team-info">
              <div class="team-name">Zeynep Kara</div>
              <div class="team-role">Teknik Lider</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">Matematik Mühendisliği 3. sınıf öğrencisi. Veri bilimi ve istatistiksel modelleme konularında uzmanlaşıyor.</p>
          <div class="team-skills">
            <span>R</span><span>Statistics</span><span>Data Science</span>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-top">
            <div class="team-avatar">🧑‍🎓</div>
            <div class="team-info">
              <div class="team-name">Mert Demir</div>
              <div class="team-role">Etkinlik Koordinatörü</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">Endüstri Mühendisliği 3. sınıf öğrencisi. Hackathon ve yazılım yarışmalarının organizasyonundan sorumlu.</p>
          <div class="team-skills">
            <span>Organizasyon</span><span>Hackathon</span>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-top">
            <div class="team-avatar">👩‍💻</div>
            <div class="team-info">
              <div class="team-name">Elif Şahin</div>
              <div class="team-role">Web Geliştirme Lideri</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">Bilgisayar Mühendisliği 2. sınıf öğrencisi. React ve full-stack geliştirme konularında aktif projeler yürütüyor.</p>
          <div class="team-skills">
            <span>React</span><span>Node.js</span><span>Full-Stack</span>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-top">
            <div class="team-avatar">🧑‍💼</div>
            <div class="team-info">
              <div class="team-name">Can Özkan</div>
              <div class="team-role">Kariyer & Sponsorluk</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">İşletme Mühendisliği 4. sınıf öğrencisi. Şirket ilişkileri ve staj programlarının koordinasyonunu yürütüyor.</p>
          <div class="team-skills">
            <span>Business Dev</span><span>Networking</span>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-top">
            <div class="team-avatar">👩‍🏫</div>
            <div class="team-info">
              <div class="team-name">Selin Arslan</div>
              <div class="team-role">Matematik Lideri</div>
            </div>
            <a href="#" class="team-social" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="white" stroke-width="2" fill="none"/>
                <rect x="2" y="9" width="4" height="12" stroke="white" stroke-width="2"/>
                <circle cx="4" cy="4" r="2" stroke="white" stroke-width="2"/>
              </svg>
            </a>
          </div>
          <p class="team-bio">Matematik Mühendisliği 4. sınıf öğrencisi. Olimpiyat hazırlık gruplarını yönetiyor, ulusal finale 3 kez katıldı.</p>
          <div class="team-skills">
            <span>Olimpiyat</span><span>Sayı Teorisi</span><span>Cebir</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="join-section">
    <div class="container">
      <div class="join-inner">
        <div>
          <h2 class="join-title">Sen de Ekibe Katıl</h2>
          <p class="join-desc">
            Yeni dönem yönetim kurulu başvuruları Eylül ayında açılıyor.
            Liderlik deneyimi kazanmak ve MINT'i birlikte büyütmek istiyorsan başvurunu yap.
          </p>
        </div>
        <a href="/contact" class="btn btn-green">Başvur →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 80px 0 60px;
    background: var(--gray);
    border-bottom: 1px solid var(--dark);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    margin-bottom: 20px;
    background: var(--green);
    display: inline-block;
    padding: 0 10px;
    border-radius: 8px;
  }
  .page-hero-desc { font-size: 18px; line-height: 1.7; color: #555; max-width: 560px; }
  .page-hero-stats { display: flex; gap: 24px; flex-shrink: 0; }
  .stat-card {
    background: var(--white);
    border: 1px solid var(--dark);
    border-radius: 20px;
    padding: 28px 32px;
    text-align: center;
    box-shadow: 4px 4px 0 var(--dark);
  }
  .stat-number { font-size: 42px; font-weight: 700; color: var(--dark); line-height: 1; margin-bottom: 6px; }
  .stat-label { font-size: 14px; color: #666; }

  .team-section { padding: 80px 0 40px; }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .team-card {
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 36px 32px;
    box-shadow: 5px 5px 0 var(--dark);
    background: var(--white);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .team-card:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 var(--dark); }
  .team-card--featured { background: var(--dark); }

  .team-card-top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--dark);
  }
  .team-card--featured .team-card-top { border-bottom-color: rgba(255,255,255,0.2); }

  .team-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 2px solid var(--dark);
    background: var(--gray);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    flex-shrink: 0;
  }
  .team-card--featured .team-avatar { border-color: var(--green); background: rgba(185,255,102,0.1); }

  .team-info { flex: 1; }
  .team-name { font-size: 18px; font-weight: 600; margin-bottom: 3px; }
  .team-card--featured .team-name { color: var(--white); }
  .team-role { font-size: 15px; color: #777; }
  .team-card--featured .team-role { color: var(--green); }

  .team-social {
    width: 34px;
    height: 34px;
    background: var(--dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.2s;
    text-decoration: none;
  }
  .team-social:hover { opacity: 0.7; }

  .team-bio { font-size: 15px; line-height: 1.65; color: #555; margin-bottom: 16px; }
  .team-card--featured .team-bio { color: rgba(255,255,255,0.75); }

  .team-skills { display: flex; flex-wrap: wrap; gap: 8px; }
  .team-skills span {
    font-size: 13px;
    padding: 3px 10px;
    border-radius: 20px;
    background: var(--gray);
    border: 1px solid rgba(25,26,35,0.2);
    color: var(--dark);
  }
  .team-card--featured .team-skills span {
    background: rgba(185,255,102,0.12);
    border-color: rgba(185,255,102,0.3);
    color: var(--green);
  }

  /* Join CTA */
  .join-section { padding: 40px 0 80px; }
  .join-inner {
    background: var(--green);
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 60px 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    box-shadow: 5px 5px 0 var(--dark);
  }
  .join-title { font-size: 36px; font-weight: 600; margin-bottom: 12px; }
  .join-desc { font-size: 18px; color: #333; line-height: 1.6; max-width: 560px; }

  @media (max-width: 1024px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .join-inner { flex-direction: column; padding: 50px 40px; }
    .page-hero-stats { gap: 16px; }
    .stat-card { padding: 20px 22px; }
    .stat-number { font-size: 32px; }
  }
  @media (max-width: 640px) {
    .team-grid { grid-template-columns: 1fr; }
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; justify-content: space-between; }
    .join-inner { padding: 40px 28px; }
  }
</style>
