---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Topluluklarımız — YTU MINT"
  description="YTU MINT bünyesindeki çalışma grupları: Yapay Zeka, Veri Bilimi, Web Geliştirme, Algoritma ve Matematik topluluklarını keşfedin."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Topluluklarımız</h1>
          <p class="page-hero-desc">
            İlgi alanına göre bir çalışma grubuna katıl, projeler geliştir ve alanında uzmanlaş.
            MINT bünyesinde 5 aktif çalışma grubumuz bulunmaktadır.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">5</div>
            <div class="stat-label">Çalışma Grubu</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">200+</div>
            <div class="stat-label">Aktif Üye</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">40+</div>
            <div class="stat-label">Tamamlanan Proje</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Communities Grid -->
  <section class="communities-section">
    <div class="container">
      <div class="communities-grid">

        <!-- Yapay Zeka -->
        <div class="community-card community-card--dark">
          <div class="community-card-icon">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="12" fill="none" stroke="#B9FF66" stroke-width="2"/>
              <circle cx="30" cy="10" r="5" fill="#B9FF66"/>
              <circle cx="48" cy="22" r="5" fill="#B9FF66"/>
              <circle cx="48" cy="42" r="5" fill="#B9FF66"/>
              <circle cx="30" cy="50" r="5" fill="#B9FF66"/>
              <circle cx="12" cy="42" r="5" fill="#B9FF66"/>
              <circle cx="12" cy="22" r="5" fill="#B9FF66"/>
              <line x1="30" y1="15" x2="30" y2="18" stroke="#B9FF66" stroke-width="1.5"/>
              <line x1="30" y1="42" x2="30" y2="45" stroke="#B9FF66" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="community-card-tag">Yapay Zeka & Makine Öğrenmesi</div>
          <p class="community-card-desc">
            Derin öğrenme, doğal dil işleme ve bilgisayarla görme konularında teorik ve pratik eğitimler.
            TensorFlow, PyTorch ve scikit-learn gibi araçlarla gerçek projeler geliştiriyoruz.
          </p>
          <ul class="community-topics">
            <li>Derin Öğrenme</li>
            <li>NLP</li>
            <li>Bilgisayarla Görme</li>
            <li>Pekiştirmeli Öğrenme</li>
          </ul>
          <div class="community-links">
            <a href="#" class="community-social-btn" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
          <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
        </div>

        <!-- Veri Bilimi -->
        <div class="community-card community-card--green">
          <div class="community-card-icon">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <rect x="8" y="38" width="10" height="14" rx="2" fill="#191A23" opacity="0.8"/>
              <rect x="25" y="28" width="10" height="24" rx="2" fill="#191A23" opacity="0.8"/>
              <rect x="42" y="18" width="10" height="34" rx="2" fill="#191A23" opacity="0.8"/>
              <polyline points="13,38 30,28 47,18" stroke="#191A23" stroke-width="2" stroke-dasharray="4,2" fill="none"/>
            </svg>
          </div>
          <div class="community-card-tag community-card-tag--white">Veri Bilimi & Analitik</div>
          <p class="community-card-desc">
            İstatistiksel analiz, veri görselleştirme ve tahmine dayalı modelleme üzerine yoğunlaşıyoruz.
            Python, R ve SQL ile veri odaklı kararlar almayı öğreniyoruz.
          </p>
          <ul class="community-topics community-topics--dark">
            <li>İstatistik & Olasılık</li>
            <li>Python & Pandas</li>
            <li>Veri Görselleştirme</li>
            <li>SQL & Veritabanı</li>
          </ul>
          <div class="community-links">
            <a href="#" class="community-social-btn community-social-btn--dark" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
          <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
        </div>

        <!-- Web Geliştirme -->
        <div class="community-card community-card--light">
          <div class="community-card-icon">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <rect x="5" y="10" width="50" height="32" rx="5" fill="none" stroke="#191A23" stroke-width="2"/>
              <line x1="5" y1="22" x2="55" y2="22" stroke="#191A23" stroke-width="2"/>
              <circle cx="13" cy="16" r="3" fill="#191A23"/>
              <circle cx="22" cy="16" r="3" fill="#191A23"/>
              <circle cx="31" cy="16" r="3" fill="#191A23"/>
              <path d="M18 36L24 28L30 32L38 24" stroke="#191A23" stroke-width="2" stroke-linecap="round"/>
              <line x1="22" y1="42" x2="38" y2="42" stroke="#191A23" stroke-width="2.5" stroke-linecap="round"/>
              <line x1="30" y1="42" x2="30" y2="50" stroke="#191A23" stroke-width="2.5"/>
            </svg>
          </div>
          <div class="community-card-tag">Web & Mobil Geliştirme</div>
          <p class="community-card-desc">
            Modern web teknolojileri ile frontend ve backend geliştirme üzerine çalışıyoruz.
            React, Next.js, Node.js ve mobil uygulama geliştirme konularında projeler yapıyoruz.
          </p>
          <ul class="community-topics">
            <li>React & Next.js</li>
            <li>Node.js & API</li>
            <li>Mobil Geliştirme</li>
            <li>DevOps & Cloud</li>
          </ul>
          <div class="community-links">
            <a href="#" class="community-social-btn community-social-btn--outline" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
            <a href="#" class="community-social-btn community-social-btn--outline" aria-label="Web Sitesi" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              Web Sitesi
            </a>
          </div>
          <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
        </div>

        <!-- Algoritma -->
        <div class="community-card community-card--light">
          <div class="community-card-icon">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="24" fill="none" stroke="#191A23" stroke-width="2" opacity="0.3"/>
              <text x="30" y="42" text-anchor="middle" font-size="36" font-family="Space Grotesk" font-weight="700" fill="#191A23" opacity="0.8">⌥</text>
            </svg>
          </div>
          <div class="community-card-tag">Algoritma Atölyeleri</div>
          <p class="community-card-desc">
            Veri yapıları, algoritma analizi ve rekabetçi programlama konularında yoğun eğitim.
            LeetCode, Codeforces ve ACM-ICPC hazırlık programlarıyla yarışmalara hazırlanıyoruz.
          </p>
          <ul class="community-topics">
            <li>Veri Yapıları</li>
            <li>Dinamik Programlama</li>
            <li>Graf Algoritmaları</li>
            <li>Rekabetçi Programlama</li>
          </ul>
          <div class="community-links">
            <a href="#" class="community-social-btn community-social-btn--outline" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
          <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
        </div>

        <!-- Matematik -->
        <div class="community-card community-card--dark">
          <div class="community-card-icon">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <polygon points="30,5 35,22 52,22 38,32 43,50 30,40 17,50 22,32 8,22 25,22" fill="none" stroke="#B9FF66" stroke-width="2"/>
              <text x="30" y="38" text-anchor="middle" font-size="18" font-family="Space Grotesk" font-weight="700" fill="#B9FF66">∑</text>
            </svg>
          </div>
          <div class="community-card-tag">Matematik Olimpiyatları</div>
          <p class="community-card-desc">
            Saf matematik, cebir, sayı teorisi ve kombinatöryal problemler üzerine haftalık çözüm seansları.
            Ulusal ve uluslararası matematik olimpiyatlarına birlikte hazırlanıyoruz.
          </p>
          <ul class="community-topics">
            <li>Sayı Teorisi</li>
            <li>Kombinatorik</li>
            <li>Cebir</li>
            <li>Olimpiyat Hazırlık</li>
          </ul>
          <div class="community-links">
            <a href="#" class="community-social-btn" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
          <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
        </div>

        <!-- CTA Card -->
        <div class="community-card community-card--cta">
          <div class="community-cta-content">
            <h3>Hangi Gruba Uyduğundan Emin Değil misin?</h3>
            <p>Bize ulaş, ilgi alanlarına göre en uygun çalışma grubunu birlikte belirleyelim.</p>
            <a href="/contact" class="btn btn-dark">Bize Ulaş →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 80px 0 60px;
    background: var(--gray);
    border-bottom: 1px solid var(--dark);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    margin-bottom: 20px;
    background: var(--green);
    display: inline-block;
    padding: 0 10px;
    border-radius: 8px;
  }
  .page-hero-desc {
    font-size: 18px;
    line-height: 1.7;
    color: #555;
    max-width: 560px;
  }
  .page-hero-stats {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
  }
  .stat-card {
    background: var(--white);
    border: 1px solid var(--dark);
    border-radius: 20px;
    padding: 28px 32px;
    text-align: center;
    box-shadow: 4px 4px 0 var(--dark);
  }
  .stat-number {
    font-size: 42px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label {
    font-size: 14px;
    color: #666;
  }

  /* Communities */
  .communities-section { padding: 80px 0; }
  .communities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .community-card {
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 44px 40px;
    box-shadow: 5px 5px 0 var(--dark);
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .community-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--dark);
  }
  .community-card--dark  { background: var(--dark); }
  .community-card--green { background: var(--green); }
  .community-card--light { background: var(--gray); }
  .community-card--cta {
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }
  .community-cta-content { text-align: center; }
  .community-cta-content h3 {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .community-cta-content p {
    font-size: 16px;
    color: #555;
    margin-bottom: 28px;
  }

  .community-card-icon { margin-bottom: 4px; }

  .community-card-tag {
    display: inline-block;
    background: var(--green);
    color: var(--dark);
    font-size: 22px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    line-height: 1.35;
  }
  .community-card-tag--white { background: var(--white); }
  .community-card--dark .community-card-tag { background: var(--green); }

  .community-card-desc {
    font-size: 16px;
    line-height: 1.7;
    color: #444;
    flex: 1;
  }
  .community-card--dark .community-card-desc { color: rgba(255,255,255,0.8); }
  .community-card--green .community-card-desc { color: #333; }

  .community-topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .community-topics li {
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(25,26,35,0.3);
    color: var(--dark);
    background: rgba(255,255,255,0.5);
  }
  .community-card--dark .community-topics li {
    border-color: rgba(185,255,102,0.4);
    color: var(--green);
    background: rgba(185,255,102,0.08);
  }
  .community-card--green .community-topics--dark li {
    border-color: rgba(25,26,35,0.3);
    background: rgba(255,255,255,0.4);
  }

  .community-btn { margin-top: auto; width: fit-content; }

  /* Social links */
  .community-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .community-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    background: var(--green);
    color: var(--dark);
    border: 1px solid var(--dark);
  }
  .community-social-btn:hover { opacity: 0.75; transform: translateY(-1px); }
  .community-social-btn--dark {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
  }
  .community-social-btn--outline {
    background: transparent;
    color: var(--dark);
    border: 1px solid rgba(25,26,35,0.3);
  }

  @media (max-width: 1024px) {
    .communities-grid { grid-template-columns: repeat(2, 1fr); }
    .page-hero-stats { gap: 16px; }
    .stat-card { padding: 20px 22px; }
    .stat-number { font-size: 32px; }
  }
  @media (max-width: 640px) {
    .communities-grid { grid-template-columns: 1fr; }
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; justify-content: space-between; }
  }
</style>
