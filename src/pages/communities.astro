---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Topluluklarımız — YTU MINT"
  description="YTU MINT bünyesindeki topluluklar: YTÜ Blockchain, Yıldız Siber, YTÜ Huawei Student Developers ve YTÜ Deptron topluluklarını keşfedin."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Topluluklarımız</h1>
          <p class="page-hero-desc">
            İlgi alanına göre bir topluluğa katıl, projeler geliştir ve alanında uzmanlaş.
            MINT bünyesinde 4 aktif topluluğumuz bulunmaktadır.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">4</div>
            <div class="stat-label">Alt Topluluk</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">200+</div>
            <div class="stat-label">Aktif Üye</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">40+</div>
            <div class="stat-label">Tamamlanan Proje</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Communities Grid -->
  <section class="communities-section">
    <div class="container">
      <div class="communities-grid">

        <!-- YTÜ Blockchain -->
        <div class="community-card community-card--dark">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/bc-logo.png" alt="YTÜ Blockchain" class="community-card-logo" />
            </div>
            <div class="community-card-tag">YTÜ Blockchain</div>
          </div>
          <p class="community-card-desc">
            Blockchain teknolojileri, Web3 ekosistemi, akıllı sözleşmeler (Smart Contracts), DeFi protokolleri ve dağıtık sistem mimarileri üzerine araştırmalar, atölyeler ve projeler yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/ytu_blockchain/" class="community-social-btn" aria-label="YTÜ Blockchain Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
              <a href="https://ytublockchain.com/tr" class="community-social-btn community-social-btn--dark-outline" aria-label="YTÜ Blockchain Web Sitesi" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- Yıldız Siber -->
        <div class="community-card community-card--green">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/yildiz-siber.png" alt="Yıldız Siber" class="community-card-logo" />
            </div>
            <div class="community-card-tag community-card-tag--white">Yıldız Siber</div>
          </div>
          <p class="community-card-desc">
            Siber güvenlik, sızma testleri (pentest), CTF yarışmaları, web uygulama güvenliği ve zararlı yazılım analizi alanlarında teorik ve uygulamalı eğitimler düzenliyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/yildizsiber/" class="community-social-btn community-social-btn--dark" aria-label="Yıldız Siber Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- YTÜ Huawei Student Developers -->
        <div class="community-card community-card--light">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/hsd-logo.png" alt="YTÜ Huawei Student Developers" class="community-card-logo" />
            </div>
            <div class="community-card-tag">YTÜ Huawei Student Developers</div>
          </div>
          <p class="community-card-desc">
            Huawei teknolojileri, mobil ekosistemler, HarmonyOS, HMS Core ve yapay zeka servisleri ile yenilikçi mobil ve bulut uygulamaları geliştiriyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/hsd.ytu/" class="community-social-btn community-social-btn--outline" aria-label="YTÜ Huawei Student Developers Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- YTÜ Deptron -->
        <div class="community-card community-card--light">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/deptron-logo.jpg" alt="YTÜ Deptron" class="community-card-logo" />
            </div>
            <div class="community-card-tag">YTÜ Deptron</div>
          </div>
          <p class="community-card-desc">
            Robotik sistemler, otonom insansız kara ve hava araçları, gömülü sistemler ve donanım tasarımı üzerine AR-GE çalışmaları ve yarışma projeleri yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/deptron_robotics/" class="community-social-btn community-social-btn--outline" aria-label="YTÜ Deptron Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
              <a href="https://deptronrobotics.com/" class="community-social-btn community-social-btn--outline" aria-label="YTÜ Deptron Web Sitesi" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-dark community-btn">Gruba Katıl →</a>
          </div>
        </div>

      </div>

      <!-- CTA Banner -->
      <div class="community-cta-banner">
        <div class="community-cta-content">
          <h3>Hangi Topluluğa Katılacağından Emin Değil misin?</h3>
          <p>Bize ulaş, ilgi alanlarına ve hedeflerine göre en uygun çalışma grubunu birlikte belirleyelim.</p>
          <a href="/contact" class="btn btn-green">Bize Ulaş →</a>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 80px 0 60px;
    background: var(--gray);
    border-bottom: 1px solid var(--dark);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    margin-bottom: 20px;
    background: var(--green);
    display: inline-block;
    padding: 0 10px;
    border-radius: 8px;
  }
  .page-hero-desc {
    font-size: 18px;
    line-height: 1.7;
    color: #555;
    max-width: 560px;
  }
  .page-hero-stats {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
  }
  .stat-card {
    background: var(--white);
    border: 1px solid var(--dark);
    border-radius: 20px;
    padding: 28px 32px;
    text-align: center;
    box-shadow: 4px 4px 0 var(--dark);
  }
  .stat-number {
    font-size: 42px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label {
    font-size: 14px;
    color: #666;
  }

  /* Communities */
  .communities-section { padding: 80px 0; }
  .communities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .community-card {
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 40px 36px;
    box-shadow: 5px 5px 0 var(--dark);
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .community-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--dark);
  }
  .community-card--dark  { background: var(--dark); }
  .community-card--green { background: var(--green); }
  .community-card--light { background: var(--white); }

  .community-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .community-card-logo-box {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: var(--white);
    border: 1.5px solid var(--dark);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    overflow: hidden;
    box-shadow: 3px 3px 0 var(--dark);
    flex-shrink: 0;
  }

  .community-card-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .community-card-tag {
    display: inline-block;
    background: var(--green);
    color: var(--dark);
    font-size: 20px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 8px;
    line-height: 1.35;
    border: 1px solid var(--dark);
  }
  .community-card-tag--white { background: var(--white); }
  .community-card--dark .community-card-tag { background: var(--green); }

  .community-card-desc {
    font-size: 16px;
    line-height: 1.7;
    color: #444;
    flex: 1;
  }
  .community-card--dark .community-card-desc { color: rgba(255,255,255,0.85); }
  .community-card--green .community-card-desc { color: #222; }

  .community-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 10px;
  }

  .community-btn { width: fit-content; padding: 12px 24px; font-size: 16px; border-radius: 14px; }

  /* Social links */
  .community-links {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: nowrap;
  }

  .community-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    background: var(--green);
    color: var(--dark);
    border: 1px solid var(--dark);
    white-space: nowrap;
  }
  .community-social-btn:hover { opacity: 0.75; transform: translateY(-1px); }
  .community-social-btn--dark {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
  }
  .community-social-btn--outline {
    background: var(--gray);
    color: var(--dark);
    border: 1px solid var(--dark);
  }
  .community-social-btn--dark-outline {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .community-social-btn--dark-outline:hover {
    background: var(--white);
    color: var(--dark);
    border-color: var(--white);
  }

  /* CTA Banner */
  .community-cta-banner {
    margin-top: 40px;
    background: var(--dark);
    color: var(--white);
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 48px 40px;
    box-shadow: 6px 6px 0 var(--green);
    text-align: center;
  }
  .community-cta-content h3 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--white);
  }
  .community-cta-content p {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 24px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 960px) {
    .communities-grid { grid-template-columns: 1fr; }
    .page-hero-stats { gap: 16px; }
    .stat-card { padding: 20px 22px; }
    .stat-number { font-size: 32px; }
  }
  @media (max-width: 640px) {
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; justify-content: space-between; }
    .community-card { padding: 28px 22px; }
    .community-cta-banner { padding: 36px 20px; }
    .community-card-footer { flex-direction: column; align-items: flex-start; gap: 14px; }
    .community-btn { width: 100%; text-align: center; justify-content: center; }
  }
</style>
