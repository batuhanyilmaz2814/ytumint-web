---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Topluluklarımız — YTU MINT"
  description="YTU MINT bünyesindeki topluluklar: YTÜ Blockchain, Yıldız Siber, YTÜ Huawei Student Developers ve YTÜ Deptron topluluklarını keşfedin."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <div class="section-badge">Ekosistem</div>
          <h1 class="page-hero-title">Topluluklarımız</h1>
          <p class="page-hero-desc">
            İlgi alanına göre bir çalışma grubuna katıl, yenilikçi projeler geliştir ve alanında uzmanlaş.
            MINT bünyesinde 4 aktif uzmanlık topluluğumuz bulunmaktadır.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">4</div>
            <div class="stat-label">Alt Topluluk</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">200+</div>
            <div class="stat-label">Aktif Üye</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">40+</div>
            <div class="stat-label">Tamamlanan Proje</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Communities Grid -->
  <section class="communities-section">
    <div class="container">
      <div class="communities-grid">

        <!-- YTÜ Blockchain -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/bc-logo.png" alt="YTÜ Blockchain" class="community-card-logo" />
            </div>
            <div>
              <span class="community-pill">Web3 & FinTech</span>
              <h2 class="community-name">YTÜ Blockchain</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Blockchain mimarisi, Web3 ekosistemi, akıllı sözleşmeler (Smart Contracts), DeFi protokolleri ve dağıtık sistem mimarileri üzerine araştırmalar, atölyeler ve projeler yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/ytu_blockchain/" class="community-social-btn" aria-label="YTÜ Blockchain Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
              <a href="https://ytublockchain.com/tr" class="community-social-btn community-social-btn--outline" aria-label="YTÜ Blockchain Web Sitesi" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- Yıldız Siber -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/yildiz-siber.png" alt="Yıldız Siber" class="community-card-logo" />
            </div>
            <div>
              <span class="community-pill">Cyber Security</span>
              <h2 class="community-name">Yıldız Siber</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Siber güvenlik, sızma testleri (pentest), CTF yarışmaları, web uygulama güvenliği ve zararlı yazılım analizi alanlarında teorik ve uygulamalı eğitimler düzenliyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/yildizsiber/" class="community-social-btn" aria-label="Yıldız Siber Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- YTÜ Huawei Student Developers -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/hsd-logo.png" alt="YTÜ Huawei Student Developers" class="community-card-logo" />
            </div>
            <div>
              <span class="community-pill">Software Dev</span>
              <h2 class="community-name">YTÜ Huawei Developers</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Huawei teknolojileri, mobil ekosistemler, HarmonyOS, HMS Core ve yapay zeka servisleri ile yenilikçi mobil ve bulut uygulamaları geliştiriyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/hsd.ytu/" class="community-social-btn" aria-label="YTÜ Huawei Student Developers Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
          </div>
        </div>

        <!-- YTÜ Deptron -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img src="/deptron-logo.jpg" alt="YTÜ Deptron" class="community-card-logo" />
            </div>
            <div>
              <span class="community-pill">Robotics & AI</span>
              <h2 class="community-name">YTÜ Deptron</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Robotik sistemler, otonom insansız kara ve hava araçları, gömülü sistemler ve donanım tasarımı üzerine AR-GE çalışmaları ve yarışma projeleri yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a href="https://www.instagram.com/deptron_robotics/" class="community-social-btn" aria-label="YTÜ Deptron Instagram" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                </svg>
                Instagram
              </a>
              <a href="https://deptronrobotics.com/" class="community-social-btn community-social-btn--outline" aria-label="YTÜ Deptron Web Sitesi" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn">Gruba Katıl →</a>
          </div>
        </div>

      </div>

      <!-- CTA Banner -->
      <div class="community-cta-banner">
        <div class="community-cta-content">
          <h3>Hangi Topluluğa Katılacağından Emin Değil misin?</h3>
          <p>Bize ulaş, ilgi alanlarına ve kariyer hedeflerine göre en uygun çalışma grubunu birlikte belirleyelim.</p>
          <a href="/contact" class="btn btn-green">Bize Ulaş →</a>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 70px 0 50px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--dark);
  }
  .page-hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 540px;
  }
  .page-hero-stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }
  .stat-card {
    background: var(--bg-main);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .stat-number {
    font-size: 32px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Communities */
  .communities-section {
    padding: 70px 0 90px;
    background: var(--bg-main);
  }
  .communities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .community-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .community-card:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: var(--shadow-hover);
  }

  .community-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .community-card-logo-box {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--bg-main);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .community-card-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .community-pill {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--green-text);
    background: var(--green-light);
    border: 1px solid var(--green-border);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 4px;
  }

  .community-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
  }

  .community-card-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
    flex: 1;
    margin: 0;
  }

  .community-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .community-btn {
    padding: 9px 18px;
    font-size: 13.5px;
  }

  .community-links {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .community-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    background: var(--bg-main);
    color: var(--dark);
    border: 1px solid var(--border);
    transition: all 0.2s ease;
  }
  .community-social-btn:hover {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
  }

  .community-social-btn--outline {
    background: transparent;
  }

  /* CTA Banner */
  .community-cta-banner {
    margin-top: 48px;
    background: var(--dark);
    color: var(--white);
    border-radius: var(--radius-lg);
    padding: 48px 36px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .community-cta-content h3 {
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--white);
  }
  .community-cta-content p {
    font-size: 16px;
    color: #94A3B8;
    margin-bottom: 24px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .communities-grid { grid-template-columns: 1fr; }
    .page-hero-stats { gap: 12px; }
  }
  @media (max-width: 640px) {
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; justify-content: space-between; }
    .community-card { padding: 24px 20px; }
    .community-card-footer { flex-direction: column; align-items: flex-start; gap: 12px; }
    .community-btn { width: 100%; text-align: center; }
  }
</style>
