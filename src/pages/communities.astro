---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Topluluklarımız | YTÜ MİNT"
  description="YTÜ MİNT bünyesindeki topluluklar: YTÜ Blockchain, Yıldız Siber, Huawei Student Developers (HSD YTU) ve YTÜ Deptron topluluklarını keşfedin."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">Topluluklarımız</h1>
      </div>
    </div>
  </section>

  <!-- Communities Grid -->
  <section class="communities-section">
    <div class="container">
      <div class="communities-grid">
        <!-- YTÜ Blockchain -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img
                src="/bc-logo.png"
                alt="YTÜ Blockchain"
                class="community-card-logo"
              />
            </div>
            <div>
              <h2 class="community-name">YTÜ Blockchain</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Blockchain mimarisi, Web3 ekosistemi, akıllı sözleşmeler (Smart
            Contracts), DeFi protokolleri ve dağıtık sistem mimarileri üzerine
            araştırmalar, atölyeler ve projeler yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a
                href="https://www.instagram.com/ytu_blockchain/"
                class="community-social-btn"
                aria-label="YTÜ Blockchain Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                  ></circle>
                </svg>
                Instagram
              </a>
              <a
                href="https://ytublockchain.com/tr"
                class="community-social-btn community-social-btn--outline"
                aria-label="YTÜ Blockchain Web Sitesi"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path
                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                  ></path>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn"
              >Gruba Katıl →</a
            >
          </div>
        </div>

        <!-- Yıldız Siber -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img
                src="/yildiz-siber.png"
                alt="Yıldız Siber"
                class="community-card-logo"
              />
            </div>
            <div>
              <h2 class="community-name">Yıldız Siber</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Siber güvenlik, sızma testleri (pentest), CTF yarışmaları, web
            uygulama güvenliği ve zararlı yazılım analizi alanlarında teorik ve
            uygulamalı eğitimler düzenliyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a
                href="https://www.instagram.com/yildizsiber/"
                class="community-social-btn"
                aria-label="Yıldız Siber Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                  ></circle>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn"
              >Gruba Katıl →</a
            >
          </div>
        </div>

        <!-- Huawei Student Developers (HSD YTÜ) -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img
                src="/hsd-logo.png"
                alt="Huawei Student Developers (HSD YTÜ)"
                class="community-card-logo"
              />
            </div>
            <div>
              <h2 class="community-name">
                Huawei Student Developers (HSD YTÜ)
              </h2>
            </div>
          </div>
          <p class="community-card-desc">
            Huawei ekosistemi, mobil ve bulut teknolojileri, yazılım geliştirme
            ve yapay zeka alanlarında öğrencilere eğitimler, atölyeler ve küresel
            proje geliştirme fırsatları sunuyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a
                href="https://www.instagram.com/hsd.ytu/"
                class="community-social-btn"
                aria-label="Huawei Student Developers YTU Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                  ></circle>
                </svg>
                Instagram
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn"
              >Gruba Katıl →</a
            >
          </div>
        </div>

        <!-- YTÜ Deptron -->
        <div class="community-card">
          <div class="community-card-header">
            <div class="community-card-logo-box">
              <img
                src="/deptron-logo.jpg"
                alt="YTÜ Deptron"
                class="community-card-logo"
              />
            </div>
            <div>
              <h2 class="community-name">YTÜ Deptron</h2>
            </div>
          </div>
          <p class="community-card-desc">
            Robotik sistemler, otonom insansız kara ve hava araçları, gömülü
            sistemler ve donanım tasarımı üzerine AR-GE çalışmaları ve yarışma
            projeleri yürütüyoruz.
          </p>
          <div class="community-card-footer">
            <div class="community-links">
              <a
                href="https://www.instagram.com/deptron_robotics/"
                class="community-social-btn"
                aria-label="YTÜ Deptron Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                  ></circle>
                </svg>
                Instagram
              </a>
              <a
                href="https://deptronrobotics.com/"
                class="community-social-btn community-social-btn--outline"
                aria-label="YTÜ Deptron Web Sitesi"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path
                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                  ></path>
                </svg>
                Web Sitesi
              </a>
            </div>
            <a href="/contact" class="btn btn-green community-btn"
              >Gruba Katıl →</a
            >
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    min-height: 120px;
    display: flex;
    align-items: center;
    padding: 32px 0;
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/mint-pattern.png');
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97, 169, 93, 0.25), transparent);
    z-index: 1;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  /* Communities */
  .communities-section {
    padding: 48px 0 72px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .communities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    max-width: 1060px;
    margin: 0 auto;
  }

  .community-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 22px;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03), 0 1px 2px rgba(15, 23, 42, 0.02);
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 12px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .community-card:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.3);
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.06), 0 3px 8px rgba(15, 23, 42, 0.03);
  }

  .community-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .community-card-logo-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    overflow: hidden;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .community-card:hover .community-card-logo-box {
    transform: scale(1.06);
  }

  .community-card-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  .community-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .community-card-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
    margin: 0;
  }

  .community-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .community-btn {
    padding: 6px 14px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: var(--radius-full);
  }

  .community-links {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .community-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    background: var(--bg-main);
    color: var(--dark);
    border: 1px solid var(--border);
    transition: all 0.2s ease;
  }

  .community-social-btn:hover {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
  }

  .community-social-btn--outline {
    background: transparent;
  }

  @media (max-width: 960px) {
    .communities-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .community-card {
      padding: 16px 16px;
    }
    .community-card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .community-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
