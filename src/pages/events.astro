---
import Layout from "../layouts/Layout.astro";
import { pastEvents } from "../data/events";

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}

const categories = [
  { id: "all", label: "Tümü" },
  { id: "Şirket Gezisi", label: "Şirket Gezisi" },
  { id: "Quiz Night", label: "Quiz Night" },
  { id: "Zirve", label: "Zirve" },
  { id: "Eğitim", label: "Eğitim" },
  { id: "Sosyal Etkinlik", label: "Sosyal Etkinlik" },
];
---

<Layout
  title="Etkinliklerimiz | YTÜ MİNT"
  description="YTÜ MİNT etkinlikleri: hackathonlar, şirket gezileri, atölyeler, quiz geceleri ve zirveler. Topluluğumuzla birlikte öğren, geliştir ve büyü."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">Etkinliklerimiz</h1>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="events-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Yaklaşan Etkinlikler</h2>
        <p class="section-description">
          Takvimimizdeki yaklaşan etkinliklere şimdiden kayıt ol, kontenjan
          dolmadan yerini ayırt.
        </p>
      </div>

      <div class="events-list">
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-day">23</span>
            <span class="event-month">Ekim 2026</span>
          </div>
          <div class="event-info">
            <h3 class="event-title">Akbank Case Study</h3>
          </div>
          <a href="/contact" class="btn btn-green event-cta">Kayıt Ol →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Past Events -->
  <section class="past-events-section">
    <div class="container">
      <div class="section-header-row">
        <div class="section-header">
          <h2 class="section-title">Geçmiş Etkinlikler</h2>
          <p class="section-description">
            Daha önce gerçekleştirdiğimiz şirket gezileri, atölyeler, zirveler
            ve topluluk buluşmaları.
          </p>
        </div>
        <div class="slider-nav">
          <button
            class="slider-nav-btn prev"
            id="pastEventsPrev"
            aria-label="Önceki etkinlikler"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </button>
          <button
            class="slider-nav-btn next"
            id="pastEventsNext"
            aria-label="Sonraki etkinlikler"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Past Events Category Filter -->
      <div
        class="events-filter-bar"
        role="tablist"
        aria-label="Etkinlik Kategorileri"
      >
        {
          categories.map((cat, index) => (
            <button
              class:list={["filter-btn", { active: index === 0 }]}
              data-category={cat.id}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <div class="past-events-slider-track" id="pastEventsSlider">
        {
          pastEvents.map((event) => {
            const { day, month } = parseEventDate(event.date);
            return (
              <div class="past-event-card" data-category={event.category}>
                <div class="past-event-img-wrap">
                  {event.image ? (
                    <img
                      src={event.image}
                      alt={event.title}
                      class="past-event-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="past-event-img-placeholder">
                      <span class="placeholder-tag">
                        {event.badge || "YTÜ MİNT"}
                      </span>
                    </div>
                  )}
                </div>
                <div class="past-event-body">
                  <div class="past-event-header">
                    <div class="past-event-date">
                      <span class="past-event-day">{day}</span>
                      <span class="past-event-month">{month}</span>
                    </div>
                  </div>
                  <h3 class="past-event-title">{event.title}</h3>
                </div>
              </div>
            );
          })
        }
      </div>

      <div
        class="events-empty-state"
        id="eventsEmptyState"
        style="display: none;"
      >
        <p>Bu kategoride henüz listelenen etkinlik bulunmuyor.</p>
      </div>
    </div>
  </section>

  <script>
    const slider = document.getElementById("pastEventsSlider");
    const prevBtn = document.getElementById(
      "pastEventsPrev",
    ) as HTMLButtonElement;
    const nextBtn = document.getElementById(
      "pastEventsNext",
    ) as HTMLButtonElement;
    const filterBtns =
      document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const eventCards =
      document.querySelectorAll<HTMLElement>(".past-event-card");
    const emptyState = document.getElementById("eventsEmptyState");

    function updateButtons() {
      if (!slider || !prevBtn || !nextBtn) return;
      const isScrollable = slider.scrollWidth > slider.clientWidth + 5;
      if (!isScrollable) {
        prevBtn.disabled = true;
        nextBtn.disabled = true;
        return;
      }
      prevBtn.disabled = slider.scrollLeft <= 10;
      nextBtn.disabled =
        slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10;
    }

    prevBtn?.addEventListener("click", () => {
      if (!slider) return;
      slider.scrollBy({ left: -slider.clientWidth, behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      if (!slider) return;
      slider.scrollBy({ left: slider.clientWidth, behavior: "smooth" });
    });

    slider?.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);

    // Filtering logic
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");

        const selectedCategory = btn.getAttribute("data-category");
        let visibleCount = 0;

        eventCards.forEach((card) => {
          const cardCategory = card.getAttribute("data-category");
          if (selectedCategory === "all" || cardCategory === selectedCategory) {
            card.classList.remove("is-hidden");
            visibleCount++;
          } else {
            card.classList.add("is-hidden");
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? "block" : "none";
        }

        if (slider) {
          slider.scrollTo({ left: 0, behavior: "smooth" });
          setTimeout(updateButtons, 120);
        }
      });
    });

    updateButtons();
  </script>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/brand/mint-pattern.webp");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(97, 169, 93, 0.25),
      transparent
    );
    z-index: 1;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  /* Upcoming Events */
  .upcoming-events-section {
    padding: 48px 0 60px;
    background: var(--bg-main);
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 1060px;
    margin: 0 auto;
  }

  .event-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow:
      0 2px 10px rgba(15, 23, 42, 0.03),
      0 1px 2px rgba(15, 23, 42, 0.02);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .event-item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--green),
      rgba(97, 169, 93, 0.3)
    );
    border-radius: 0 2px 2px 0;
  }

  .event-item:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.3);
    box-shadow:
      0 12px 28px -6px rgba(15, 23, 42, 0.06),
      0 3px 8px rgba(15, 23, 42, 0.03);
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--green-light);
    border: 1px solid var(--green-border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    flex-shrink: 0;
    min-width: 70px;
  }

  .event-day {
    font-size: 24px;
    font-weight: 700;
    color: var(--green-text);
    line-height: 1;
  }

  .event-month {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--green-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }

  .event-info {
    flex: 1;
  }

  .event-title {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--dark);
    letter-spacing: -0.01em;
  }

  .event-desc {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 6px;
  }

  .event-meta {
    font-size: 12.5px;
    color: var(--text-subtle);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .event-cta {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--radius-full);
  }

  /* Past events */
  .past-events-section {
    padding: 48px 0 72px;
    background: var(--bg-subtle);
    position: relative;
    overflow: hidden;
  }

  .past-events-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(97, 169, 93, 0.25),
      transparent
    );
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 16px;
  }

  .slider-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .slider-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .slider-nav-btn:hover:not(:disabled) {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .slider-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Filter Bar */
  .events-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .filter-btn {
    appearance: none;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    font-family: var(--font);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  .filter-btn:hover {
    background: var(--bg-muted);
    color: var(--dark);
    border-color: rgba(97, 169, 93, 0.35);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(97, 169, 93, 0.28);
    transform: translateY(-1px);
  }

  .past-events-slider-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px 2px 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .past-events-slider-track::-webkit-scrollbar {
    display: none;
  }

  .past-event-card {
    flex: 0 0 calc(25% - 12px);
    min-width: 230px;
    max-width: 290px;
    scroll-snap-align: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow:
      0 2px 10px rgba(15, 23, 42, 0.03),
      0 1px 2px rgba(15, 23, 42, 0.02);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .past-event-card:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.35);
    box-shadow: var(--shadow-hover);
  }

  .past-event-card.is-hidden {
    display: none !important;
  }

  .past-event-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .past-event-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .past-event-card:hover .past-event-img {
    transform: scale(1.05);
  }

  .past-event-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(97, 169, 93, 0.12) 0%,
      rgba(15, 23, 42, 0.05) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-tag {
    font-size: 12px;
    font-weight: 600;
    color: var(--green-text);
    background: var(--green-light);
    border: 1px solid var(--green-border);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .past-event-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    min-height: 88px;
  }

  .past-event-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .past-event-date {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .past-event-day {
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
  }

  .past-event-month {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--dark);
  }

  .past-event-title {
    font-size: 15.5px;
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    line-height: 1.35;
    min-height: 42px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .events-empty-state {
    padding: 48px 24px;
    text-align: center;
    background: var(--white);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 14px;
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .past-event-card {
      flex: 0 0 calc(33.333% - 11px);
      min-width: 220px;
    }
    .event-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .event-cta {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .past-event-card {
      flex: 0 0 240px;
      min-width: 240px;
    }
    .section-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .events-filter-bar {
      gap: 6px;
    }
    .filter-btn {
      padding: 7px 14px;
      font-size: 12.5px;
    }
    .event-item {
      padding: 24px 20px;
    }
  }
</style>
