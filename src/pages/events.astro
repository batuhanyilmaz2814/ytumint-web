---
import Layout from "../layouts/Layout.astro";
import { pastEvents } from "../data/events";

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}
---

<Layout
  title="Etkinliklerimiz | YTÜ MİNT"
  description="YTÜ MİNT etkinlikleri: hackathonlar, şirket gezileri, atölyeler, quiz geceleri ve zirveler. Topluluğumuzla birlikte öğren, geliştir ve büyü."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">Etkinliklerimiz</h1>
        <p class="page-hero-desc">
          Şirket gezileri, atölyeler, tematik yarışmalar ve teknik zirveler |
          her dönem dopdolu bir etkinlik programı ile yanındayız.
        </p>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="events-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Yaklaşan Etkinlikler</h2>
        <p class="section-description">
          Takvimimizdeki yaklaşan etkinliklere şimdiden kayıt ol, kontenjan
          dolmadan yerini ayırt.
        </p>
      </div>

      <div class="events-list">
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-day">23</span>
            <span class="event-month">Ekim</span>
          </div>
          <div class="event-info">
            <h3 class="event-title">Akbank Case Study</h3>
            <p class="event-desc">
              1 günlük inovatif fikirleri paylaşma ve finansal teknoloji
              çözümleri geliştirme günü | 35.000 TL ödül havuzu.
            </p>
            <div class="event-meta">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Sabancı Center Akbank Genel Müdürlük
            </div>
          </div>
          <a href="/contact" class="btn btn-green event-cta">Kayıt Ol →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Past Events -->
  <section class="past-events-section">
    <div class="container">
      <div class="section-header-row">
        <div class="section-header">
          <h2 class="section-title">Geçmiş Etkinlikler</h2>
          <p class="section-description">
            Daha önce gerçekleştirdiğimiz şirket gezileri, atölyeler, zirveler ve
            topluluk buluşmaları.
          </p>
        </div>
        <div class="slider-nav">
          <button
            class="slider-nav-btn prev"
            id="pastEventsPrev"
            aria-label="Önceki etkinlikler"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </button>
          <button
            class="slider-nav-btn next"
            id="pastEventsNext"
            aria-label="Sonraki etkinlikler"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="past-events-slider-track" id="pastEventsSlider">
        {
          pastEvents.map((event) => {
            const { day, month } = parseEventDate(event.date);
            return (
              <div class="past-event-card">
                <div class="past-event-img-wrap">
                  {event.image ? (
                    <img
                      src={event.image}
                      alt={event.title}
                      class="past-event-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="past-event-img-placeholder">
                      <span class="placeholder-tag">{event.badge || "YTÜ MİNT"}</span>
                    </div>
                  )}
                </div>
                <div class="past-event-body">
                  <div class="past-event-header">
                    <div class="past-event-date">
                      <span class="past-event-day">{day}</span>
                      <span class="past-event-month">{month}</span>
                    </div>
                  </div>
                  <h3 class="past-event-title">{event.title}</h3>
                  <p class="past-event-desc">{event.desc}</p>
                  <div class="past-event-footer">
                    <div class="past-event-meta">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                      {event.location}
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <script>
    const slider = document.getElementById("pastEventsSlider");
    const prevBtn = document.getElementById("pastEventsPrev") as HTMLButtonElement;
    const nextBtn = document.getElementById("pastEventsNext") as HTMLButtonElement;

    function updateButtons() {
      if (!slider || !prevBtn || !nextBtn) return;
      prevBtn.disabled = slider.scrollLeft <= 10;
      nextBtn.disabled =
        slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10;
    }

    prevBtn?.addEventListener("click", () => {
      if (!slider) return;
      slider.scrollBy({ left: -slider.clientWidth, behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      if (!slider) return;
      slider.scrollBy({ left: slider.clientWidth, behavior: "smooth" });
    });

    slider?.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  </script>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 80px 0 60px;
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/mint-pattern.png');
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97, 169, 93, 0.25), transparent);
    z-index: 1;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  .page-hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Upcoming Events */
  .events-section {
    padding: 80px 0 50px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .event-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 36px;
    display: flex;
    align-items: center;
    gap: 32px;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.02);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .event-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--green), rgba(97, 169, 93, 0.3));
    border-radius: 0 2px 2px 0;
  }

  .event-item:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.3);
    box-shadow: 0 16px 40px -8px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.04);
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--green-light);
    border: 1px solid var(--green-border);
    border-radius: var(--radius-md);
    padding: 16px 22px;
    flex-shrink: 0;
    min-width: 86px;
  }

  .event-day {
    font-size: 32px;
    font-weight: 700;
    color: var(--green-text);
    line-height: 1;
  }

  .event-month {
    font-size: 13px;
    font-weight: 600;
    color: var(--green-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 3px;
  }

  .event-info {
    flex: 1;
  }

  .event-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--dark);
    letter-spacing: -0.01em;
  }

  .event-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .event-meta {
    font-size: 13.5px;
    color: var(--text-subtle);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .event-cta {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 11px 24px;
    font-size: 14.5px;
    font-weight: 600;
    border-radius: var(--radius-full);
  }

  /* Past events */
  .past-events-section {
    padding: 60px 0 100px;
    background: var(--bg-subtle);
    position: relative;
    overflow: hidden;
  }

  .past-events-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97, 169, 93, 0.25), transparent);
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 20px;
  }

  .slider-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .slider-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .slider-nav-btn:hover:not(:disabled) {
    background: var(--green);
    color: var(--white);
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .slider-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .past-events-slider-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 6px 4px 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .past-events-slider-track::-webkit-scrollbar {
    display: none;
  }

  .past-event-card {
    flex: 0 0 calc(33.333% - 14px);
    min-width: 300px;
    max-width: 380px;
    scroll-snap-align: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    display: flex;
    flex-direction: column;
  }
  .past-event-card:hover {
    transform: translateY(-4px);
    border-color: rgba(16, 185, 129, 0.35);
    box-shadow: var(--shadow-hover);
  }

  .past-event-img-wrap {
    width: 100%;
    height: 185px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .past-event-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .past-event-card:hover .past-event-img {
    transform: scale(1.06);
  }

  .past-event-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(97, 169, 93, 0.12) 0%, rgba(15, 23, 42, 0.05) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--green-text);
    background: var(--green-light);
    border: 1px solid var(--green-border);
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .past-event-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .past-event-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .past-event-date {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .past-event-day {
    font-size: 28px;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
  }

  .past-event-month {
    font-size: 14px;
    font-weight: 600;
    color: var(--dark);
  }

  .past-event-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    color: var(--dark);
  }
  .past-event-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  .past-event-footer {
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .past-event-meta {
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 1024px) {
    .past-event-card {
      flex: 0 0 calc(50% - 10px);
      min-width: 280px;
    }
    .event-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .event-cta {
      width: 100%;
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .past-event-card {
      flex: 0 0 100%;
      min-width: 260px;
    }
    .section-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .event-item {
      padding: 24px 20px;
    }
  }
</style>
