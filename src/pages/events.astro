---
import Layout from '../layouts/Layout.astro';
import { pastEvents } from '../data/events';
---

<Layout
  title="Etkinliklerimiz — YTU MINT"
  description="YTU MINT etkinlikleri: hackathonlar, şirket gezileri, atölyeler, quiz geceleri ve zirveler. Topluluğumuzla birlikte öğren, geliştir ve büyü."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Etkinliklerimiz</h1>
          <p class="page-hero-desc">
            Şirket gezileri, atölyeler, tematik yarışmalar ve teknik zirveler — her dönem dopdolu bir etkinlik programı ile yanındayız.
          </p>
        </div>
        <div class="page-hero-stats">
          <div class="stat-card">
            <div class="stat-number">{pastEvents.length}+</div>
            <div class="stat-label">Geçmiş Etkinlik</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">500+</div>
            <div class="stat-label">Katılımcı</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="events-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Yaklaşan Etkinlikler</h2>
        <p class="section-description">
          Takvimimizdeki yaklaşan etkinliklere şimdiden kayıt ol, kontenjan dolmadan yerini ayırt.
        </p>
      </div>

      <div class="events-list">
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-day">23</span>
            <span class="event-month">Ekim</span>
          </div>
          <div class="event-info">
            <h3 class="event-title">Akbank Case Study</h3>
            <p class="event-desc">
              1 günlük inovatif fikirleri paylaşma ve finansal teknoloji çözümleri geliştirme günü — 35.000 TL ödül havuzu.
            </p>
            <div class="event-meta">
              <span>📍 Sabancı Center Akbank Genel Müdürlük</span>
            </div>
          </div>
          <a href="/contact" class="btn btn-green event-cta">Kayıt Ol →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Past Events -->
  <section class="past-events-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Geçmiş Etkinlikler</h2>
        <p class="section-description">
          Daha önce gerçekleştirdiğimiz şirket gezileri, atölyeler, zirveler ve topluluk buluşmaları.
        </p>
      </div>

      <div class="past-events-grid">
        {pastEvents.map((event) => (
          <div class="past-event-card">
            <h3 class="past-event-title">{event.title}</h3>
            <p class="past-event-desc">{event.desc}</p>
            <div class="past-event-meta">
              <span class="meta-date">📅 {event.date}</span>
              <span class="meta-location">📍 {event.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 70px 0 50px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .page-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .page-hero-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--dark);
  }
  .page-hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 540px;
  }
  .page-hero-stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }
  .stat-card {
    background: var(--bg-main);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 28px;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .stat-number {
    font-size: 32px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Upcoming Events */
  .events-section {
    padding: 70px 0 40px;
    background: var(--bg-main);
  }
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .event-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 36px;
    display: flex;
    align-items: center;
    gap: 32px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .event-item:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: var(--shadow-hover);
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--green-light);
    border: 1px solid var(--green-border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    flex-shrink: 0;
    min-width: 80px;
  }
  .event-day {
    font-size: 32px;
    font-weight: 700;
    color: var(--green-text);
    line-height: 1;
  }
  .event-month {
    font-size: 13px;
    font-weight: 600;
    color: var(--green-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }

  .event-info {
    flex: 1;
  }


  .event-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--dark);
  }
  .event-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .event-meta {
    font-size: 13.5px;
    color: var(--text-subtle);
  }

  .event-cta {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 10px 22px;
  }

  /* Past events */
  .past-events-section {
    padding: 40px 0 90px;
    background: var(--bg-main);
  }
  .past-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .past-event-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .past-event-card:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: var(--shadow-hover);
  }



  .past-event-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--dark);
  }
  .past-event-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .past-event-meta {
    font-size: 12.5px;
    color: var(--text-subtle);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }
  .meta-date {
    font-weight: 500;
    color: var(--text-muted);
  }
  .meta-location {
    opacity: 0.9;
  }

  @media (max-width: 1024px) {
    .past-events-grid { grid-template-columns: repeat(2, 1fr); }
    .event-item { flex-direction: column; align-items: flex-start; gap: 20px; }
    .event-cta { width: 100%; text-align: center; }
  }
  @media (max-width: 640px) {
    .past-events-grid { grid-template-columns: 1fr; }
    .page-hero-inner { flex-direction: column; }
    .page-hero-stats { width: 100%; }
    .event-item { padding: 24px 20px; }
  }
</style>
