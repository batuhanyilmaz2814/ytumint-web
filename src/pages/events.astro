---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { pastEvents, upcomingEvents } from "../data/events";

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}

const allEvents = [
  ...upcomingEvents.map((event) => ({
    ...event,
    category: event.category || "Eğitim",
    isUpcoming: true,
  })),
  ...pastEvents.map((event) => ({
    ...event,
    isUpcoming: false,
  })),
];

const categories = [
  { id: "all", label: "Tümü" },
  { id: "upcoming", label: "Yakında" },
  { id: "Şirket Gezisi", label: "Şirket Gezisi" },
  { id: "Quiz Night", label: "Quiz Night" },
  { id: "Zirve", label: "Zirve" },
  { id: "Eğitim", label: "Eğitim" },
  { id: "Sosyal Etkinlik", label: "Sosyal Etkinlik" },
];
---

<Layout
  title="Etkinliklerimiz | YTÜ MİNT"
  description="YTÜ MİNT etkinlikleri: hackathonlar, şirket gezileri, atölyeler, quiz geceleri ve zirveler. Topluluğumuzla birlikte öğren, geliştir ve büyü."
  keywords="YTÜ etkinlikleri, hackathon, şirket gezisi, teknoloji zirvesi, yazılım eğitimi, quiz night, YTÜ MİNT etkinlikleri, workshop, atölye, teknoloji etkinlikleri"
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">Etkinliklerimiz</h1>
      </div>
    </div>
  </section>

  <!-- Breadcrumbs -->
  <Breadcrumb currentPage="Etkinliklerimiz" />

  <!-- Events Main Section -->
  <section class="events-main-section">
    <div class="container">
      <!-- Category Filter & Controls Row -->
      <div class="events-filter-row">
        <div
          class="events-filter-bar"
          role="tablist"
          aria-label="Etkinlik Kategorileri"
        >
          {
            categories.map((cat, index) => (
              <button
                class:list={["filter-btn", { active: index === 0 }]}
                data-category={cat.id}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
              >
                {cat.label}
              </button>
            ))
          }
        </div>

        <div class="past-events-controls">
          <!-- View Switcher Toggle (Icons only: Grid & List) -->
          <div class="view-mode-toggle" role="group" aria-label="Görünüm Modu">
            <button
              class="view-toggle-btn active"
              id="viewGridBtn"
              data-view="grid"
              title="Izgara Görünümü"
              aria-label="Izgara Görünümü"
            >
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </button>
            <button
              class="view-toggle-btn"
              id="viewListBtn"
              data-view="list"
              title="Liste Görünümü"
              aria-label="Liste Görünümü"
            >
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <circle cx="3.5" cy="6" r="1.5" fill="currentColor"></circle>
                <circle cx="3.5" cy="12" r="1.5" fill="currentColor"></circle>
                <circle cx="3.5" cy="18" r="1.5" fill="currentColor"></circle>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Events Container -->
      <div class="past-events-container view-grid" id="pastEventsContainer">
        {
          allEvents.map((event) => {
            const { day, month } = parseEventDate(event.date);
            return (
              <div
                class:list={[
                  "past-event-card",
                  { "upcoming-event-card": event.isUpcoming },
                ]}
                data-category={event.category}
                data-upcoming={event.isUpcoming ? "true" : "false"}
              >
                <div class="past-event-img-wrap">
                  {event.image ? (
                    <img
                      src={event.image}
                      alt={event.title}
                      class="past-event-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="past-event-img-placeholder"></div>
                  )}
                  {event.isUpcoming && (
                    <span class="upcoming-badge">Yakında</span>
                  )}
                </div>
                <div class="past-event-body">
                  <div class="past-event-header">
                    <div class="past-event-date">
                      <span class="past-event-day">{day}</span>
                      <span class="past-event-month">{month}</span>
                    </div>
                  </div>
                  <h3 class="past-event-title">{event.title}</h3>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Load More Button (For Grid & List modes) -->
      <div class="load-more-wrapper" id="loadMoreWrapper">
        <button class="btn btn-outline load-more-btn" id="loadMoreBtn">
          <span>Daha Fazla Etkinlik Göster</span>
          <span class="load-more-counter" id="loadMoreCounter"></span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
      </div>

      <div
        class="events-empty-state"
        id="eventsEmptyState"
        style="display: none;"
      >
        <p>Bu kategoride henüz listelenen etkinlik bulunmuyor.</p>
      </div>
    </div>
  </section>

  <script>
    const container = document.getElementById("pastEventsContainer");
    const viewToggleBtns =
      document.querySelectorAll<HTMLButtonElement>(".view-toggle-btn");
    const filterBtns =
      document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const eventCards =
      document.querySelectorAll<HTMLElement>(".past-event-card");
    const emptyState = document.getElementById("eventsEmptyState");
    const loadMoreWrapper = document.getElementById("loadMoreWrapper");
    const loadMoreBtn = document.getElementById(
      "loadMoreBtn",
    ) as HTMLButtonElement;
    const loadMoreCounter = document.getElementById("loadMoreCounter");

    let currentView: "grid" | "list" = "grid";
    let selectedCategory = "all";
    const PAGE_SIZE = 12;
    let visibleLimit = PAGE_SIZE;

    function normalizeText(text: string) {
      return text
        .toLowerCase()
        .trim()
        .replace(/ı/g, "i")
        .replace(/ğ/g, "g")
        .replace(/ü/g, "u")
        .replace(/ş/g, "s")
        .replace(/ö/g, "o")
        .replace(/ç/g, "c")
        .replace(/\s+/g, "-");
    }

    function updateUrlParams() {
      const url = new URL(window.location.href);
      if (selectedCategory && selectedCategory !== "all") {
        url.searchParams.set("category", selectedCategory);
      } else {
        url.searchParams.delete("category");
      }

      if (currentView && currentView !== "grid") {
        url.searchParams.set("view", currentView);
      } else {
        url.searchParams.delete("view");
      }

      window.history.replaceState({}, "", url.toString());
    }

    function setCategory(category: string, updateUrl = true) {
      let matchedBtn: HTMLButtonElement | null = null;

      filterBtns.forEach((btn) => {
        const cat = btn.getAttribute("data-category") || "";
        const isMatch =
          cat.toLowerCase() === category.toLowerCase() ||
          normalizeText(cat) === normalizeText(category);
        if (isMatch) {
          matchedBtn = btn;
        }
      });

      if (!matchedBtn && category !== "all") {
        matchedBtn = document.querySelector('.filter-btn[data-category="all"]');
      }

      const targetCategory = matchedBtn
        ? matchedBtn.getAttribute("data-category") || "all"
        : "all";

      selectedCategory = targetCategory;
      visibleLimit = PAGE_SIZE;

      filterBtns.forEach((b) => {
        const isActive =
          (b.getAttribute("data-category") || "all") === selectedCategory;
        b.classList.toggle("active", isActive);
        b.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      if (updateUrl) {
        updateUrlParams();
      }

      renderEvents();
    }

    function setView(view: "grid" | "list", updateUrl = true) {
      if (!container || (view !== "grid" && view !== "list")) return;
      currentView = view;
      container.className = `past-events-container view-${view}`;

      viewToggleBtns.forEach((b) => {
        const isActive = b.getAttribute("data-view") === view;
        b.classList.toggle("active", isActive);
      });

      if (updateUrl) {
        updateUrlParams();
      }
    }

    function renderEvents() {
      if (!container) return;

      let matchingCount = 0;
      const matchingCards: HTMLElement[] = [];

      // Determine matching cards for the selected category
      eventCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category") || "";
        const isUpcoming = card.getAttribute("data-upcoming") === "true";

        let matches = false;
        if (selectedCategory === "all") {
          matches = true;
        } else if (selectedCategory === "upcoming") {
          matches = isUpcoming;
        } else {
          matches =
            cardCategory.toLowerCase() === selectedCategory.toLowerCase() ||
            normalizeText(cardCategory) === normalizeText(selectedCategory);
        }

        if (matches) {
          card.classList.remove("is-category-hidden");
          matchingCards.push(card);
          matchingCount++;
        } else {
          card.classList.add("is-category-hidden");
          card.classList.remove("is-paginated-hidden");
        }
      });

      // Handle empty state
      if (emptyState) {
        emptyState.style.display = matchingCount === 0 ? "block" : "none";
        const emptyMsg = emptyState.querySelector("p");
        if (emptyMsg) {
          emptyMsg.textContent =
            selectedCategory === "upcoming"
              ? "Şu an planlanan yaklaşan etkinlik bulunmuyor."
              : "Bu kategoride henüz listelenen etkinlik bulunmuyor.";
        }
      }

      // Grid or List mode with Load More pagination
      matchingCards.forEach((card, index) => {
        if (index < visibleLimit) {
          card.classList.remove("is-paginated-hidden");
        } else {
          card.classList.add("is-paginated-hidden");
        }
      });

      if (loadMoreWrapper) {
        if (matchingCount > visibleLimit) {
          loadMoreWrapper.style.display = "flex";
          if (loadMoreCounter) {
            loadMoreCounter.textContent = `${Math.min(visibleLimit, matchingCount)} / ${matchingCount}`;
          }
        } else {
          loadMoreWrapper.style.display = "none";
        }
      }
    }

    // View switcher handler (Grid & List)
    viewToggleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const view = btn.getAttribute("data-view") as "grid" | "list";
        if (view) setView(view);
      });
    });

    // Category filter handler
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category") || "all";
        setCategory(cat);
      });
    });

    // Load more handler
    loadMoreBtn?.addEventListener("click", () => {
      visibleLimit += PAGE_SIZE;
      renderEvents();
    });

    // Initialize state from URL params
    function initFromUrl() {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get("category");
      const viewParam = urlParams.get("view") as "grid" | "list" | null;

      if (viewParam === "list" || viewParam === "grid") {
        setView(viewParam, false);
      }

      if (catParam) {
        setCategory(catParam, false);
      } else {
        renderEvents();
      }
    }

    window.addEventListener("popstate", () => {
      initFromUrl();
    });

    initFromUrl();
  </script>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/brand/mint-pattern.webp");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(97, 169, 93, 0.25),
      transparent
    );
    z-index: 1;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  /* Events Main Section */
  .events-main-section {
    padding: 36px 0 72px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .upcoming-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--green);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(97, 169, 93, 0.35);
    z-index: 2;
  }

  .event-card-cta {
    font-size: 12px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    line-height: 1.3;
    box-shadow: none;
  }

  .upcoming-event-card {
    border-color: rgba(97, 169, 93, 0.3);
  }

  .events-filter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .past-events-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* View Mode Toggle (Icons Only) */
  .view-mode-toggle {
    display: flex;
    align-items: center;
    gap: 3px;
    background: var(--bg-muted);
    padding: 3px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .view-toggle-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .view-toggle-btn:hover {
    color: var(--dark);
    background: rgba(0, 0, 0, 0.04);
  }

  .view-toggle-btn.active {
    background: var(--white);
    color: var(--dark);
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.08);
  }

  :global([data-theme="dark"]) .view-toggle-btn.active {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  /* Filter Bar */
  .events-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
  }

  .filter-btn {
    appearance: none;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    font-family: var(--font);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  .filter-btn:hover {
    background: var(--bg-muted);
    color: var(--dark);
    border-color: rgba(97, 169, 93, 0.35);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(97, 169, 93, 0.28);
    transform: translateY(-1px);
  }

  /* ── Past Events Container Modes (Grid & List) ───────────── */

  /* Base Card */
  .past-event-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow:
      0 2px 10px rgba(15, 23, 42, 0.03),
      0 1px 2px rgba(15, 23, 42, 0.02);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .past-event-card:hover {
    transform: translateY(-3px);
    border-color: rgba(97, 169, 93, 0.35);
    box-shadow: var(--shadow-hover);
  }

  .past-event-card.is-category-hidden,
  .past-event-card.is-paginated-hidden {
    display: none !important;
  }

  .past-event-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .past-event-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .past-event-card:hover .past-event-img {
    transform: scale(1.05);
  }

  .past-event-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(97, 169, 93, 0.12) 0%,
      rgba(15, 23, 42, 0.05) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-tag {
    font-size: 12px;
    font-weight: 600;
    color: var(--green-text);
    background: var(--green-light);
    border: 1px solid var(--green-border);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .past-event-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    min-height: 88px;
  }

  .past-event-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .past-event-date {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .past-event-day {
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
  }

  .past-event-month {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--dark);
  }

  .past-event-title {
    font-size: 15.5px;
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    line-height: 1.35;
    min-height: 42px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 1. GRID VIEW */
  .past-events-container.view-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 4px 0 16px;
  }

  .past-events-container.view-grid .past-event-card {
    flex: none;
    max-width: 100%;
    min-width: 0;
    animation: fadeInCard 0.3s ease;
  }

  /* 2. LIST VIEW */
  .past-events-container.view-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 0 16px;
  }

  .past-events-container.view-list .past-event-card {
    flex-direction: row;
    align-items: center;
    padding: 12px 18px;
    gap: 18px;
    animation: fadeInCard 0.3s ease;
  }

  .past-events-container.view-list .past-event-img-wrap {
    width: 110px;
    height: 75px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    aspect-ratio: auto;
  }

  .past-events-container.view-list .past-event-body {
    padding: 0;
    min-height: auto;
    gap: 4px;
    flex: 1;
  }

  .past-events-container.view-list .past-event-title {
    min-height: auto;
    font-size: 16px;
    -webkit-line-clamp: 1;
  }

  @keyframes fadeInCard {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Load More Pagination */
  .load-more-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .load-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-full);
    cursor: pointer;
    background: var(--white);
    color: var(--dark);
    border: 1px solid var(--border);
    transition: all 0.25s ease;
  }

  .load-more-btn:hover {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(97, 169, 93, 0.28);
  }

  .load-more-counter {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: var(--bg-muted);
    color: var(--text-muted);
  }

  .load-more-btn:hover .load-more-counter {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .events-empty-state {
    padding: 48px 24px;
    text-align: center;
    background: var(--white);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 14px;
    width: 100%;
    margin-top: 8px;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .past-events-container.view-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 768px) {
    .past-events-container.view-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
