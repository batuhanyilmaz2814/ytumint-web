---
import Layout from "../layouts/Layout.astro";
import { pastEvents, upcomingEvents } from "../data/events";

const TR_MONTHS: Record<string, number> = {
  ocak: 0,
  şubat: 1,
  mart: 2,
  nisan: 3,
  mayıs: 4,
  haziran: 5,
  temmuz: 6,
  ağustos: 7,
  eylül: 8,
  ekim: 9,
  kasım: 10,
  aralık: 11,
};
const parseTRDate = (d: string) => {
  const lower = d.toLowerCase().replace(/\d+-\d+\s+/, "");
  const day = parseInt(d.match(/\d+/)?.[0] || "1");
  const monthStr =
    lower.split(" ").find((p) => TR_MONTHS[p] !== undefined) || "";
  const year = parseInt(d.match(/\d{4}/)?.[0] || "2024");
  return new Date(year, TR_MONTHS[monthStr] ?? 0, day);
};
const recentPastEvents = [...pastEvents]
  .sort((a, b) => parseTRDate(b.date).getTime() - parseTRDate(a.date).getTime())
  .slice(0, 4);

const sponsors = [
  { name: "Arkas Lojistik", logo: "/sponsors/arkas-lojistik-logo.webp" },
  { name: "Halıcı Elektronik", logo: "/sponsors/halici-logo.webp" },
  { name: "Kariyer.net", logo: "/sponsors/kariyernet-logo.webp" },
  { name: "Techcareer.net", logo: "/sponsors/techcareer-logo.webp" },
  { name: "Sui Foundation", logo: "/sponsors/sui-logo.webp" },
  { name: "YTÜ Startup House", logo: "/sponsors/ytu-startup-house-logo.webp" },
  { name: "Reeder", logo: "/sponsors/reeder-logo.webp" },
  { name: "Tatilciniz", logo: "/sponsors/tatilciniz-logo.webp" },
  { name: "Indomie", logo: "/sponsors/indomie-logo.webp" },
  { name: "Karnaval Müzik", logo: "/sponsors/karnaval-muzik-logo.webp" },
];

const repeatedSponsors = [...sponsors, ...sponsors];

const partnerItems = [
  { name: "Proje", type: "ai" },
  { name: "Teknoloji", type: "tech" },
  { name: "İnovasyon", type: "innovation" },
  { name: "Networking", type: "networking" },
  { name: "Multidisipliner", type: "multidisciplinary" },
  { name: "Topluluk Etkinlikleri", type: "community" },
  { name: "Hackathon", type: "hackathon" },
  { name: "Staj & Kariyer", type: "career" },
];

const marqueeRepeated = [
  ...partnerItems,
  ...partnerItems,
  ...partnerItems,
  ...partnerItems,
];

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}
