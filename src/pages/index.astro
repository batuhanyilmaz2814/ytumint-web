---
import Layout from "../layouts/Layout.astro";
import { pastEvents } from "../data/events";

const sponsors = [
  { name: "Arkas Lojistik", logo: "/arkas-lojistik-logo.png" },
  { name: "Halıcı Elektronik", logo: "/halici-logo.png" },
  { name: "Kariyer.net", logo: "/kariyernet-logo.webp" },
  { name: "Techcareer.net", logo: "/techcareer-logo.png" },
  { name: "Sui Foundation", logo: "/sui-logo.png" },
  { name: "YTÜ Startup House", logo: "/ytu-startup-house-logo.png" },
  { name: "Reeder", logo: "/reeder-logo.webp" },
  { name: "Tatilciniz", logo: "/tatilciniz-logo.jpg" },
  { name: "Indomie", logo: "/indomie-logo.png" },
  { name: "Karnaval Müzik", logo: "/karnaval-muzik-logo.jpg" },
];

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}
