            placeholder="Mesajınız..."
            id="homeMessage"
            rows="4"
            required></textarea>

          <button
            type="submit"
            class="btn btn-green submit-btn"
            id="homeSubmitBtn"
          >
            Mesajı Gönder →
          </button>
