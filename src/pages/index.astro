  <section class="contact-home-section" id="iletisim">
    <div class="container">
      <div class="contact-card">
        <div class="contact-card-header">
          <h2 class="section-title">Bize Ulaşın</h2>
          <p class="contact-desc">
            Topluluğumuza katılmak, projelerimiz hakkında bilgi almak ya da iş
            birliği için mesaj bırakın.
          </p>
        </div>

        <form class="contact-form" id="homeContactForm" novalidate>
          <div class="form-grid">
            <input
              type="text"
              class="form-input"
              placeholder="Adınız Soyadınız"
              id="homeName"
              required
            />
            <input
              type="email"
              class="form-input"
              placeholder="E-posta adresiniz"
              id="homeEmail"
              required
            />
          </div>

          <input
            type="text"
            class="form-input"
            placeholder="Konu"
            id="homeSubject"
            required
          />

          <textarea
            class="form-input"
            placeholder="Mesajınız..."
            id="homeMessage"
            rows="4"
            required></textarea>

          <button
            type="submit"
            class="btn btn-green submit-btn"
            id="homeSubmitBtn"
          >
            Mesajı Gönder →
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Tab switching & Slider
    const tabs = document.querySelectorAll(".events-tab");
    const panelUpcoming = document.getElementById("panelUpcoming");
    const panelPast = document.getElementById("panelPast");
    const homePastNav = document.getElementById("homePastNav");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const which = (tab as HTMLElement).dataset.tab;
        if (which === "upcoming") {
          panelUpcoming?.classList.remove("hidden");
          panelPast?.classList.add("hidden");
          homePastNav?.classList.add("hidden");
        } else {
          panelUpcoming?.classList.add("hidden");
          panelPast?.classList.remove("hidden");
          homePastNav?.classList.remove("hidden");
          updateHomePastButtons();
        }
      });
    });

    // Home past events slider buttons
    const homePastTrack = document.getElementById("homePastTrack");
    const homePastPrev = document.getElementById(
      "homePastPrev",
    ) as HTMLButtonElement;
    const homePastNext = document.getElementById(
      "homePastNext",
    ) as HTMLButtonElement;

    function updateHomePastButtons() {
      if (!homePastTrack || !homePastPrev || !homePastNext) return;
      homePastPrev.disabled = homePastTrack.scrollLeft <= 10;
      homePastNext.disabled =
        homePastTrack.scrollLeft + homePastTrack.clientWidth >=
        homePastTrack.scrollWidth - 10;
    }

    homePastPrev?.addEventListener("click", () => {
      if (!homePastTrack) return;
      homePastTrack.scrollBy({
        left: -homePastTrack.clientWidth,
        behavior: "smooth",
      });
    });

    homePastNext?.addEventListener("click", () => {
      if (!homePastTrack) return;
      homePastTrack.scrollBy({
        left: homePastTrack.clientWidth,
        behavior: "smooth",
      });
    });

    homePastTrack?.addEventListener("scroll", updateHomePastButtons, {
      passive: true,
    });
    window.addEventListener("resize", updateHomePastButtons);

    // Contact form feedback
    const contactForm = document.getElementById(
      "homeContactForm",
    ) as HTMLFormElement;
    const submitBtn = document.getElementById(
      "homeSubmitBtn",
    ) as HTMLButtonElement;
    contactForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = (
        document.getElementById("homeName") as HTMLInputElement
      )?.value.trim();
      const email = (
        document.getElementById("homeEmail") as HTMLInputElement
      )?.value.trim();
      const subject = (
        document.getElementById("homeSubject") as HTMLInputElement
      )?.value.trim();
      const message = (
        document.getElementById("homeMessage") as HTMLTextAreaElement
      )?.value.trim();
      if (!name || !email || !subject || !message) return;
      submitBtn.textContent = "✓ Mesajınız iletildi!";
      submitBtn.style.background = "#61a95d";
      setTimeout(() => {
        submitBtn.textContent = "Mesajı Gönder →";
        submitBtn.style.background = "";
        contactForm.reset();
      }, 3500);
    });
  </script>
</Layout>

