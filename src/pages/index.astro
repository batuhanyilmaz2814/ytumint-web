---
import Layout from "../layouts/Layout.astro";
import { pastEvents } from "../data/events";

const sponsors = [
  { name: "Arkas Lojistik", logo: "/arkas-lojistik-logo.png" },
  { name: "Halıcı Elektronik", logo: "/halici-logo.png" },
  { name: "Kariyer.net", logo: "/kariyernet-logo.webp" },
  { name: "Techcareer.net", logo: "/techcareer-logo.png" },
  { name: "Sui Foundation", logo: "/sui-logo.png" },
  { name: "YTÜ Startup House", logo: "/ytu-startup-house-logo.png" },
  { name: "Reeder", logo: "/reeder-logo.webp" },
  { name: "Tatilciniz", logo: "/tatilciniz-logo.jpg" },
  { name: "Indomie", logo: "/indomie-logo.png" },
  { name: "Karnaval Müzik", logo: "/karnaval-muzik-logo.jpg" },
];

const repeatedSponsors = [...sponsors, ...sponsors];

const partnerItems = [
  { name: "Proje", type: "ai" },
  { name: "Teknoloji", type: "tech" },
  { name: "İnovasyon", type: "innovation" },
  { name: "Networking", type: "networking" },
  { name: "Multidisipliner", type: "multidisciplinary" },
  { name: "Topluluk Etkinlikleri", type: "community" },
  { name: "Hackathon", type: "hackathon" },
  { name: "Staj & Kariyer", type: "career" },
];

const marqueeRepeated = [
  ...partnerItems,
  ...partnerItems,
  ...partnerItems,
  ...partnerItems,
];

function parseEventDate(dateStr: string) {
  const parts = dateStr.trim().split(" ");
  if (parts.length >= 2) {
    return { day: parts[0], month: parts.slice(1).join(" ") };
  }
  return { day: "", month: dateStr };
}
---

<Layout
  title="YTÜ MİNT Kulübü"
  description="YTÜ MİNT | Yıldız Teknik Üniversitesi Matematik ve Bilişim Topluluğu. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk."
>
  <!-- =============================================
       HERO
       ============================================= -->
  <section class="hero-video">
    <video
      class="hero-video__bg"
      id="heroVideo"
      data-src="/mint-video.mp4"
      autoplay
      loop
      muted
      playsinline
      preload="none"></video>

    <script>
      window.addEventListener("load", () => {
        const video = document.getElementById("heroVideo") as HTMLVideoElement;
        if (video && video.dataset.src) {
          video.src = video.dataset.src;
        }
      });
    </script>

    <div class="hero-video__overlay"></div>

    <div class="hero-video__content">
      <p class="hero-video__sub">
        YTÜ Multidisipliner İnovasyon Teknolojileri Kulübü
      </p>
      <h1 class="hero-video__title">
        May the <span class="hero-video__title-accent">MİNT</span><br />be with
        you!
      </h1>
      <div class="hero-video__btns">
        <a href="/events" class="btn btn-green">Etkinliklerimiz</a>
        <a href="/communities" class="btn btn-outline-white">Topluluklarımız</a>
      </div>
    </div>
