  <script>
    // ── Events Tab switching ──────────────────────────────────────────────────
    const tabs = document.querySelectorAll('.events-tab');
    const panels = { upcoming: document.getElementById('panelUpcoming'), past: document.getElementById('panelPast') };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const which = (tab as HTMLElement).dataset.tab as 'upcoming' | 'past';
        Object.entries(panels).forEach(([key, el]) => {
          el?.classList.toggle('hidden', key !== which);
        });
        // reset sliders on switch
        upcomingCurrent = 0;
        pastCurrent = 0;
        updateSlider(document.getElementById('eventsSlider'), upcomingCurrent, document.querySelectorAll('#eventDots .slider-dot'));
        updateSlider(document.getElementById('pastEventsSlider'), pastCurrent, document.querySelectorAll('#pastDots .slider-dot'));
      });
    });

    // ── Slider helper ─────────────────────────────────────────────────────────
    function updateSlider(slider: HTMLElement | null, index: number, dots: NodeListOf<Element>) {
      if (!slider) return;
      const cards = slider.querySelectorAll('.event-home-card');
      const gap = 30;
      const cardWidth = (slider.parentElement as HTMLElement)?.offsetWidth || 400;
      slider.style.transform = `translateX(calc(-${index} * (${cardWidth}px + ${gap}px)))`;
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
    }

    // ── Upcoming slider ───────────────────────────────────────────────────────
    let upcomingCurrent = 0;
    const upcomingTotal = 4;
    const upcomingSlider = document.getElementById('eventsSlider');
    const upcomingDots = document.querySelectorAll('#eventDots .slider-dot');

    function goUpcoming(index: number) {
      upcomingCurrent = (index + upcomingTotal) % upcomingTotal;
      updateSlider(upcomingSlider, upcomingCurrent, upcomingDots);
    }

    document.getElementById('eventPrev')?.addEventListener('click', () => goUpcoming(upcomingCurrent - 1));
    document.getElementById('eventNext')?.addEventListener('click', () => goUpcoming(upcomingCurrent + 1));
    upcomingDots.forEach(d => d.addEventListener('click', () => goUpcoming(parseInt((d as HTMLElement).dataset.index || '0'))));
    const upcomingAuto = setInterval(() => goUpcoming(upcomingCurrent + 1), 5000);

    // ── Past slider ───────────────────────────────────────────────────────────
    let pastCurrent = 0;
    const pastTotal = 4;
    const pastSlider = document.getElementById('pastEventsSlider');
    const pastDots = document.querySelectorAll('#pastDots .slider-dot');

    function goPast(index: number) {
      pastCurrent = (index + pastTotal) % pastTotal;
      updateSlider(pastSlider, pastCurrent, pastDots);
    }

    document.getElementById('pastPrev')?.addEventListener('click', () => goPast(pastCurrent - 1));
    document.getElementById('pastNext')?.addEventListener('click', () => goPast(pastCurrent + 1));
    pastDots.forEach(d => d.addEventListener('click', () => goPast(parseInt((d as HTMLElement).dataset.index || '0'))));

    // ── Contact form ──────────────────────────────────────────────────────────
    const contactForm = document.getElementById('homeContactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('homeSubmitBtn') as HTMLButtonElement;
    contactForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('homeName') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('homeEmail') as HTMLInputElement)?.value.trim();
      const message = (document.getElementById('homeMessage') as HTMLTextAreaElement)?.value.trim();
      if (!name || !email || !message) return;
      submitBtn.textContent = '✓ Mesajınız iletildi!';
      submitBtn.style.background = '#B9FF66';
      submitBtn.style.color = '#191A23';
      submitBtn.style.borderColor = '#B9FF66';
      setTimeout(() => {
        submitBtn.textContent = 'Gönder →';
        submitBtn.style.background = '';
        submitBtn.style.color = '';
        submitBtn.style.borderColor = '';
        contactForm.reset();
      }, 3500);
    });
  </script>

