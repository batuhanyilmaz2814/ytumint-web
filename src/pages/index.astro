  <script>
    // Tab switching for events
    const tabs = document.querySelectorAll(".events-tab");
    const panelPast = document.getElementById("panelPast");
    const panelUpcoming = document.getElementById("panelUpcoming");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const which = (tab as HTMLElement).dataset.tab;
        if (which === "upcoming") {
          panelPast?.classList.add("hidden");
          panelUpcoming?.classList.remove("hidden");
        } else {
          panelUpcoming?.classList.add("hidden");
          panelPast?.classList.remove("hidden");
        }
      });
    });

    // Count-up animation for About Section stats
    const statsContainer = document.getElementById("aboutStats");
    const statElements = document.querySelectorAll<HTMLElement>(
      ".about-stat-number[data-target]",
    );

    if (statsContainer && statElements.length > 0) {
      let animated = false;

      const animateStats = () => {
        if (animated) return;
        animated = true;

        const duration = 1500; // 1.5 saniye
        const startTime = performance.now();

        const updateCount = (currentTime: number) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          statElements.forEach((el) => {
            const target = parseInt(el.dataset.target || "0", 10);
            const suffix = el.dataset.suffix || "";
            let current: number;

            if (target <= 10) {
              // Küçük rakamlar (Topluluk: 4) için takılmayı önleyen dengeli adımlama
              current = Math.min(
                target,
                Math.round(Math.pow(progress, 0.75) * target),
              );
            } else {
              // Büyük rakamlar (4000+, 200+) için yumuşak cubic yavaşlama
              const easeProgress = 1 - Math.pow(1 - progress, 3);
              current = Math.min(target, Math.floor(easeProgress * target));
            }

            el.textContent = `${current.toLocaleString("tr-TR")}${suffix}`;
          });

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            statElements.forEach((el) => {
              const target = parseInt(el.dataset.target || "0", 10);
              const suffix = el.dataset.suffix || "";
              el.textContent = `${target.toLocaleString("tr-TR")}${suffix}`;
            });
          }
        };

        requestAnimationFrame(updateCount);
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateStats();
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.25, rootMargin: "0px 0px -30px 0px" },
        );
        observer.observe(statsContainer);
      } else {
        animateStats();
      }
    }
  </script>
