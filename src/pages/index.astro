        <a href="/events" class="btn btn-outline see-more-btn">
          Tümünü Gör
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path
              d="M5 12H19M19 12L13 6M19 12L13 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Tabs & Slider Navigation -->
      <div class="events-tabs-row">
        <div class="events-tabs">
          <button
            class="events-tab active"
            id="tabUpcoming"
            data-tab="upcoming"
          >
            Yaklaşan Etkinlikler
          </button>
          <button class="events-tab" id="tabPast" data-tab="past">
            Geçmiş Etkinlikler
          </button>
        </div>

        <div class="events-slider-nav hidden" id="homePastNav">
          <button
            class="slider-nav-btn prev"
            id="homePastPrev"
            aria-label="Önceki etkinlikler"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </button>
          <button
            class="slider-nav-btn next"
            id="homePastNext"
            aria-label="Sonraki etkinlikler"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Upcoming Events Slider -->
      <div class="events-slider-wrapper" id="panelUpcoming">
        <div class="events-slider-container">
          <div class="events-slider" id="eventsSlider">
            <div class="event-home-card">
              <div class="event-home-header">
                <div class="event-home-date">
                  <span class="event-home-day">23</span>
                  <span class="event-home-month">Ekim</span>
                </div>
              </div>
              <h3 class="event-home-title">Akbank Case Study</h3>
              <p class="event-home-desc">
                1 günlük inovatif fikirleri paylaşma ve çözüm geliştirme günü |
                35.000 TL ödül havuzu.
              </p>
              <div class="event-home-footer">
                <div class="event-home-meta">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                    ></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  Sabancı Center Akbank Genel Müdürlük
                </div>
                <a href="/events" class="btn btn-green event-home-cta"
                  >Kayıt Ol →</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Past Events Slider -->
      <div class="events-slider-wrapper hidden" id="panelPast">
        <div class="events-slider-container">
          <div class="past-events-home-track" id="homePastTrack">
            {
              pastEvents.map((event) => {
                const { day, month } = parseEventDate(event.date);
                return (
                  <div class="past-event-card past-slider-card">
                    <div class="past-event-img-wrap">
                      {event.image ? (
                        <img
                          src={event.image}
                          alt={event.title}
                          class="past-event-img"
                          loading="lazy"
                        />
                      ) : (
                        <div class="past-event-img-placeholder">
                          <span class="placeholder-tag">
                            {event.badge || "YTÜ MİNT"}
                          </span>
                        </div>
                      )}
                    </div>
                    <div class="past-event-body">
                      <div class="past-event-header">
                        <div class="past-event-date">
                          <span class="past-event-day">{day}</span>
                          <span class="past-event-month">{month}</span>
                        </div>
                      </div>
                      <h3 class="past-event-title">{event.title}</h3>
                      <p class="past-event-desc">{event.desc}</p>
                      <div class="past-event-footer">
                        <div class="past-event-meta">
                          <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                            <circle cx="12" cy="10" r="3" />
                          </svg>
                          {event.location}
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
