---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="YTU MINT — Matematik & Bilişim Topluluğu"
  description="YTU MINT — Yıldız Teknik Üniversitesi Matematik ve Bilişim Topluluğu. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk."
>

  <!-- =============================================
       HERO
       ============================================= -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <h1 class="hero-title">
            Matematiğin Gücüyle<br />Teknolojiyi Şekillendiriyoruz
          </h1>
          <p class="hero-desc">
            YTU MINT, Yıldız Teknik Üniversitesi'nde matematik, bilişim ve yazılım alanlarında öğrencileri bir araya getiren dinamik bir topluluktur. Projeler, etkinlikler ve eğitimlerle kariyer yolculuğuna güçlü bir başlangıç yap.
          </p>
          <div style="display:flex;gap:20px;flex-wrap:wrap;">
            <a href="/events" class="btn btn-dark">Etkinliklerimiz</a>
            <a href="/communities" class="btn btn-outline">Topluluklarımız</a>
          </div>
        </div>

        <div class="hero-image">
          <div class="hero-illustration">
            <svg viewBox="0 0 560 400" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="560" height="400" rx="30" fill="#F3F3F3"/>
              <g opacity="0.15">
                {Array.from({length: 8}).map((_, row) =>
                  Array.from({length: 12}).map((_, col) => (
                    <circle cx={(col * 50) + 25} cy={(row * 50) + 25} r="2" fill="#191A23"/>
                  ))
                )}
              </g>
              <rect x="60" y="60" width="120" height="120" rx="20" fill="#B9FF66" opacity="0.9"/>
              <text x="120" y="135" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="48" font-weight="700" fill="#191A23">∑</text>
              <circle cx="380" cy="120" r="70" fill="#191A23"/>
              <text x="380" y="138" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="40" font-weight="700" fill="#B9FF66">π</text>
              <rect x="200" y="220" width="160" height="80" rx="15" fill="#191A23"/>
              <text x="280" y="268" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="500" fill="#B9FF66">YTU MINT</text>
              <circle cx="100" cy="300" r="40" fill="#B9FF66" opacity="0.7"/>
              <text x="100" y="313" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="28" font-weight="700" fill="#191A23">∞</text>
              <polygon points="440,240 480,320 400,320" fill="#B9FF66" opacity="0.8"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       PARTNERS MARQUEE
       ============================================= -->
  <div class="partners">
    <div class="partners-track">
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        Matematik Olimpiyatları
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Kodlama Atölyeleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Yapay Zeka Projeleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Veri Bilimi
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Topluluk Etkinlikleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Hackathon
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Staj & Kariyer
      </span>
      <!-- duplicate for seamless loop -->
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        Matematik Olimpiyatları
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Kodlama Atölyeleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Yapay Zeka Projeleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Veri Bilimi
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Topluluk Etkinlikleri
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Hackathon
      </span>
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Staj & Kariyer
      </span>
    </div>
  </div>

  <!-- =============================================
       BİZ KİMİZ
       ============================================= -->
  <section class="about-section" id="biz-kimiz">
    <div class="container">
      <div class="about-inner">
        <div class="about-content">
          <span class="section-chip">Biz Kimiz?</span>
          <h2 class="about-title">
            Matematiği ve teknolojiyi<br />
            <span class="about-title-highlight">birlikte keşfediyoruz</span>
          </h2>
          <p class="about-text">
            YTU MINT; Yıldız Teknik Üniversitesi'nde matematik, bilişim ve teknoloji alanlarında ilgi duyan öğrencilerin bir araya geldiği bir öğrenci topluluğudur.
          </p>
          <p class="about-text">
            Akademik bilgiyi pratiğe dökmek, birlikte projeler geliştirmek ve birbirimizden öğrenmek için buradayız. Ne bir dernek ciddiyeti ne de sıradan bir grup sohbeti — sadece ortak tutkuyu paylaşan insanlar.
          </p>
          <div class="about-stats">
            <div class="about-stat">
              <span class="about-stat-number">200+</span>
              <span class="about-stat-label">Aktif Üye</span>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <span class="about-stat-number">4</span>
              <span class="about-stat-label">Alt Topluluk</span>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <span class="about-stat-number">30+</span>
              <span class="about-stat-label">Yıllık Etkinlik</span>
            </div>
          </div>
        </div>

        <div class="about-photo">
          <div class="about-photo-placeholder">
            <div class="photo-placeholder-inner">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#191A23" stroke-width="1.5" opacity="0.3">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <p class="photo-placeholder-text">Etkinlik fotoğrafı<br/>yakında eklenecek</p>
            </div>
          </div>
          <div class="about-photo-badge">
            <span>📸</span>
            <span>YTU MINT Ailesi</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       TOPLULUKLARIMIZ
       ============================================= -->
  <section class="communities-home-section" id="topluluklarimiz">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-chip">Alt Topluluklarımız</span>
          <h2 class="section-title-lg">Topluluklarımız</h2>
        </div>
        <a href="/communities" class="btn btn-outline see-more-btn">
          Daha Fazla
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="communities-home-grid">

        <!-- Yapay Zeka -->
        <div class="community-home-card community-home-card--dark">
          <div class="community-home-icon">
            <svg width="48" height="48" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="12" fill="none" stroke="#B9FF66" stroke-width="2"/>
              <circle cx="30" cy="10" r="5" fill="#B9FF66"/>
              <circle cx="48" cy="22" r="5" fill="#B9FF66"/>
              <circle cx="48" cy="42" r="5" fill="#B9FF66"/>
              <circle cx="30" cy="50" r="5" fill="#B9FF66"/>
              <circle cx="12" cy="42" r="5" fill="#B9FF66"/>
              <circle cx="12" cy="22" r="5" fill="#B9FF66"/>
            </svg>
          </div>
          <h3 class="community-home-name">Yapay Zeka & ML</h3>
          <p class="community-home-desc">Derin öğrenme, NLP ve bilgisayarla görme üzerine projeler</p>
          <div class="community-home-links">
            <a href="#" class="community-link-btn" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
        </div>

        <!-- Veri Bilimi -->
        <div class="community-home-card community-home-card--green">
          <div class="community-home-icon">
            <svg width="48" height="48" viewBox="0 0 60 60" fill="none">
              <rect x="8" y="38" width="10" height="14" rx="2" fill="#191A23" opacity="0.8"/>
              <rect x="25" y="28" width="10" height="24" rx="2" fill="#191A23" opacity="0.8"/>
              <rect x="42" y="18" width="10" height="34" rx="2" fill="#191A23" opacity="0.8"/>
              <polyline points="13,38 30,28 47,18" stroke="#191A23" stroke-width="2" stroke-dasharray="4,2" fill="none"/>
            </svg>
          </div>
          <h3 class="community-home-name">Veri Bilimi</h3>
          <p class="community-home-desc">İstatistik, analitik ve tahmine dayalı modelleme</p>
          <div class="community-home-links">
            <a href="#" class="community-link-btn community-link-btn--dark" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
        </div>

        <!-- Web & Mobil -->
        <div class="community-home-card community-home-card--light">
          <div class="community-home-icon">
            <svg width="48" height="48" viewBox="0 0 60 60" fill="none">
              <rect x="5" y="10" width="50" height="32" rx="5" fill="none" stroke="#191A23" stroke-width="2"/>
              <line x1="5" y1="22" x2="55" y2="22" stroke="#191A23" stroke-width="2"/>
              <circle cx="13" cy="16" r="3" fill="#191A23"/>
              <circle cx="22" cy="16" r="3" fill="#191A23"/>
              <circle cx="31" cy="16" r="3" fill="#191A23"/>
              <path d="M18 36L24 28L30 32L38 24" stroke="#191A23" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="community-home-name">Web & Mobil</h3>
          <p class="community-home-desc">Frontend, backend ve mobil uygulama geliştirme</p>
          <div class="community-home-links">
            <a href="#" class="community-link-btn community-link-btn--outline" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
        </div>

        <!-- Algoritma -->
        <div class="community-home-card community-home-card--light">
          <div class="community-home-icon">
            <svg width="48" height="48" viewBox="0 0 60 60" fill="none">
              <circle cx="30" cy="30" r="24" fill="none" stroke="#191A23" stroke-width="2" opacity="0.3"/>
              <text x="30" y="42" text-anchor="middle" font-size="36" font-family="Space Grotesk" font-weight="700" fill="#191A23" opacity="0.8">⌥</text>
            </svg>
          </div>
          <h3 class="community-home-name">Algoritma Atölyeleri</h3>
          <p class="community-home-desc">Rekabetçi programlama ve olimpiyat hazırlık</p>
          <div class="community-home-links">
            <a href="#" class="community-link-btn community-link-btn--outline" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
              Instagram
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =============================================
       ETKİNLİKLER
       ============================================= -->
  <section class="events-home-section" id="etkinlikler">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-chip">Neler Yapıyoruz?</span>
          <h2 class="section-title-lg">Etkinlikler</h2>
        </div>
        <a href="/events" class="btn btn-outline see-more-btn">
          Tümünü Gör
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Tabs -->
      <div class="events-tabs">
        <button class="events-tab active" id="tabUpcoming" data-tab="upcoming">Yaklaşan Etkinlikler</button>
        <button class="events-tab" id="tabPast" data-tab="past">Geçmiş Etkinlikler</button>
      </div>

      <!-- Upcoming Events Slider -->
      <div class="events-slider-wrapper" id="panelUpcoming">
        <div class="events-slider-container">
          <div class="events-slider" id="eventsSlider">

            <div class="event-home-card event-home-card--featured">
              <div class="event-home-date">
                <span class="event-home-day">14</span>
                <span class="event-home-month">Eyl</span>
              </div>
              <div class="event-home-tag">Hackathon</div>
              <h3 class="event-home-title">MINT Hackathon 2024</h3>
              <p class="event-home-desc">48 saatlik kodlama maratonu — tema: "Sürdürülebilir Teknoloji". 30.000 TL ödül havuzu.</p>
              <div class="event-home-meta">📍 YTU Davutpaşa Kampüsü</div>
              <a href="/events" class="btn btn-green event-home-cta">Kayıt Ol →</a>
            </div>

            <div class="event-home-card">
              <div class="event-home-date">
                <span class="event-home-day">21</span>
                <span class="event-home-month">Eyl</span>
              </div>
              <div class="event-home-tag event-home-tag--light">Atölye</div>
              <h3 class="event-home-title">Python ile Makine Öğrenmesi</h3>
              <p class="event-home-desc">Sıfırdan makine öğrenmesi: veri ön işleme, model eğitimi ve değerlendirme.</p>
              <div class="event-home-meta">📍 Online (Zoom)</div>
              <a href="/events" class="btn btn-outline event-home-cta">Detaylar →</a>
            </div>

            <div class="event-home-card">
              <div class="event-home-date">
                <span class="event-home-day">28</span>
                <span class="event-home-month">Eyl</span>
              </div>
              <div class="event-home-tag event-home-tag--light">Seminer</div>
              <h3 class="event-home-title">Kariyer Günleri 2024</h3>
              <p class="event-home-desc">Sektörden konuşmacılar ve MINT mezunlarıyla buluşma — CV, mülakat, staj ipuçları.</p>
              <div class="event-home-meta">📍 YTU Konferans Salonu</div>
              <a href="/events" class="btn btn-outline event-home-cta">Detaylar →</a>
            </div>

            <div class="event-home-card">
              <div class="event-home-date">
                <span class="event-home-day">05</span>
                <span class="event-home-month">Eki</span>
              </div>
              <div class="event-home-tag event-home-tag--light">Olimpiyat</div>
              <h3 class="event-home-title">Ulusal Matematik Olimpiyatı Seçme Sınavı</h3>
              <p class="event-home-desc">MINT temsilcilerini belirleyecek seçme sınavı. Kazananlar aylık hazırlık programına dahil edilecek.</p>
              <div class="event-home-meta">📍 YTU Matematik Mühendisliği</div>
              <a href="/events" class="btn btn-outline event-home-cta">Detaylar →</a>
            </div>

          </div>
        </div>

        <div class="slider-nav">
          <button class="slider-btn" id="eventPrev" aria-label="Önceki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M19 12H5M5 12L11 18M5 12L11 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="slider-dots" id="eventDots">
            <button class="slider-dot active" data-index="0" aria-label="1. etkinlik"></button>
            <button class="slider-dot" data-index="1" aria-label="2. etkinlik"></button>
            <button class="slider-dot" data-index="2" aria-label="3. etkinlik"></button>
            <button class="slider-dot" data-index="3" aria-label="4. etkinlik"></button>
          </div>
          <button class="slider-btn" id="eventNext" aria-label="Sonraki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Past Events Slider -->
      <div class="events-slider-wrapper hidden" id="panelPast">
        <div class="events-slider-container">
          <div class="events-slider" id="pastEventsSlider">

            <div class="event-home-card event-home-card--dark">
              <div class="past-event-badge">🏆 1. Ödül</div>
              <h3 class="event-home-title">YTU Hackathon 2023</h3>
              <p class="event-home-desc">"Sağlık için Yapay Zeka" projesiyle birincilik ve 15.000 TL ödül kazandık.</p>
              <div class="event-home-meta" style="color:rgba(255,255,255,0.5)">Mart 2023 • 48 Saat • 50+ Takım</div>
            </div>

            <div class="event-home-card event-home-card--green">
              <div class="past-event-badge past-event-badge--white">🎓 5 Finalist</div>
              <h3 class="event-home-title">Ulusal Matematik Olimpiyatı 2023</h3>
              <p class="event-home-desc">5 üyemiz finale kaldı, 2'si birincilik ödülü kazandı.</p>
              <div class="event-home-meta">Mayıs 2023 • Ankara</div>
            </div>

            <div class="event-home-card">
              <div class="past-event-badge past-event-badge--dark">📦 1200+ ⭐</div>
              <h3 class="event-home-title">Açık Kaynak Proje</h3>
              <p class="event-home-desc">MINT bünyesinde geliştirilen proje GitHub'da 1200+ yıldız topladı.</p>
              <div class="event-home-meta">2022–2023 • 50+ Katkıcı</div>
