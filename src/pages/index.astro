---
import Layout from "../layouts/Layout.astro";
import { pastEvents } from "../data/events";

const teamMembers = [
  {
    ad: "Zeynep Cemre Çebitürk",
    unvan: "Başkan",
    emoji: "👩‍💼",
  },
  {
    ad: "Melike Nur Bakırcı",
    unvan: "Başkan Yardımcısı",
    emoji: "👩‍💻",
  },
  {
    ad: "Ceren Şengüler",
    unvan: "Sekreter - Org. Koordinatörü",
    emoji: "👩‍🏫",
  },
  {
    ad: "Batuhan Yılmaz",
    unvan: "Sayman",
    emoji: "👨‍💻",
  },
  {
    ad: "Duygu Tunç",
    unvan: "Sponsorluk Koordinatörü",
    emoji: "👩‍💼",
  },
  {
    ad: "Arda Türk",
    unvan: "Sosyal Medya Koordinatörü",
    emoji: "🧑‍🎨",
  },
  {
    ad: "Nisa Hamarat",
    unvan: "Sosyal Medya Koord. Yrd.",
    emoji: "👩‍🎨",
  },
];
---

<Layout
  title="YTÜ MİNT Kulübü"
  description="YTU MINT — Yıldız Teknik Üniversitesi Matematik ve Bilişim Topluluğu. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk."
>
  <!-- =============================================
       HERO
       ============================================= -->
  <section class="hero-video">
    <!-- Video background -->
    <video
      class="hero-video__bg"
      src="/mint-video.mp4"
      autoplay
      loop
      muted
      playsinline
      preload="auto"></video>

    <!-- Gradient overlay -->
    <div class="hero-video__overlay"></div>

    <!-- Content -->
    <div class="hero-video__content">
      <p class="hero-video__sub">
        YTÜ Multidisipliner İnovasyon Teknolojileri Kulübü
      </p>
      <h1 class="hero-video__title">
        May Be MİNT<br /><span class="hero-video__title-accent">With You!</span>
      </h1>
      <div class="hero-video__btns">
        <a href="/events" class="btn btn-green">Etkinliklerimiz</a>
        <a href="/communities" class="btn btn-outline-white">Topluluklarımız</a>
      </div>
    </div>
  </section>

  <!-- =============================================
       PARTNERS MARQUEE
       ============================================= -->
  <div class="partners">
    <div class="partners-track">
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
          ><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
          ></path></svg
        >
        Matematik Olimpiyatları
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="3" y="3" width="7" height="7"></rect><rect
            x="14"
            y="3"
            width="7"
            height="7"></rect><rect x="14" y="14" width="7" height="7"
          ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
        >
        Kodlama Atölyeleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="12" cy="12" r="10"></circle><line
            x1="12"
            y1="8"
            x2="12"
            y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg
        >
        Yapay Zeka Projeleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
        >
        Veri Bilimi
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
            cx="9"
            cy="7"
            r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
            d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
        >
        Topluluk Etkinlikleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
            x1="8"
            y1="21"
            x2="16"
            y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
        >
        Hackathon
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          ></polygon></svg
        >
        Staj & Kariyer
      </span>
      <!-- duplicate for seamless loop -->
      <span class="partner-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
          ><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
          ></path></svg
        >
        Matematik Olimpiyatları
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="3" y="3" width="7" height="7"></rect><rect
            x="14"
            y="3"
            width="7"
            height="7"></rect><rect x="14" y="14" width="7" height="7"
          ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
        >
        Kodlama Atölyeleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="12" cy="12" r="10"></circle><line
            x1="12"
            y1="8"
            x2="12"
            y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg
        >
        Yapay Zeka Projeleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
        >
        Veri Bilimi
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
            cx="9"
            cy="7"
            r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
            d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
        >
        Topluluk Etkinlikleri
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
            x1="8"
            y1="21"
            x2="16"
            y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
        >
        Hackathon
      </span>
      <span class="partner-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          ></polygon></svg
        >
        Staj & Kariyer
      </span>
    </div>
  </div>

  <!-- =============================================
       BİZ KİMİZ
       ============================================= -->
  <section class="about-section" id="biz-kimiz">
    <div class="container">
      <div class="about-inner">
        <div class="about-content">
          <span class="section-chip">Biz Kimiz?</span>
          <h2 class="about-title">
            Matematiği ve teknolojiyi<br />
            <span class="about-title-highlight">birlikte keşfediyoruz</span>
          </h2>
          <p class="about-text">
            YTU MINT; Yıldız Teknik Üniversitesi'nde matematik, bilişim ve
            teknoloji alanlarında ilgi duyan öğrencilerin bir araya geldiği bir
            öğrenci topluluğudur.
          </p>
          <p class="about-text">
            Akademik bilgiyi pratiğe dökmek, birlikte projeler geliştirmek ve
            birbirimizden öğrenmek için buradayız. Ne bir dernek ciddiyeti ne de
            sıradan bir grup sohbeti — sadece ortak tutkuyu paylaşan insanlar.
          </p>
          <div class="about-stats">
            <div class="about-stat">
              <span class="about-stat-number">200+</span>
              <span class="about-stat-label">Aktif Üye</span>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <span class="about-stat-number">4</span>
              <span class="about-stat-label">Alt Topluluk</span>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <span class="about-stat-number">30+</span>
              <span class="about-stat-label">Yıllık Etkinlik</span>
            </div>
          </div>
        </div>

        <div class="about-photo">
          <div class="about-photo-wrapper">
            <img
              src="/mint-ekip.jpg"
              alt="YTU MINT Ekibi"
              class="about-photo-img"
              loading="lazy"
            />
            <div class="about-photo-overlay"></div>
          </div>
          <div class="about-photo-badge">
            <span>📸</span>
            <span>YTU MINT Ailesi</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       TOPLULUKLARIMIZ
       ============================================= -->
  <section class="communities-home-section" id="topluluklarimiz">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-chip">Alt Topluluklarımız</span>
          <h2 class="section-title-lg">Topluluklarımız</h2>
        </div>
        <a href="/communities" class="btn btn-outline see-more-btn">
          Daha Fazla
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path
              d="M5 12H19M19 12L13 6M19 12L13 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="communities-home-grid">
        <!-- YTÜ Blockchain -->
        <div class="community-home-card community-home-card--dark">
          <div class="community-home-logo-box">
            <img
              src="/bc-logo.png"
              alt="YTÜ Blockchain"
              class="community-home-logo"
            />
          </div>
          <h3 class="community-home-name">YTÜ Blockchain</h3>
          <div class="community-home-links">
            <a
              href="https://www.instagram.com/ytu_blockchain/"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn"
              aria-label="YTÜ Blockchain Instagram"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="currentColor"
                  stroke-width="2"></rect>
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"></circle>
              </svg>
              Instagram
            </a>
            <a
              href="https://ytublockchain.com/tr"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn community-link-btn--dark-outline"
              aria-label="YTÜ Blockchain Web Sitesi"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
              Web Sitesi
            </a>
          </div>
        </div>

        <!-- Yıldız Siber -->
        <div class="community-home-card community-home-card--green">
          <div class="community-home-logo-box">
            <img
              src="/yildiz-siber.png"
              alt="Yıldız Siber"
              class="community-home-logo"
            />
          </div>
          <h3 class="community-home-name">Yıldız Siber</h3>
          <div class="community-home-links">
            <a
              href="https://www.instagram.com/yildizsiber/"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn community-link-btn--dark"
              aria-label="Yıldız Siber Instagram"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="currentColor"
                  stroke-width="2"></rect>
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"></circle>
              </svg>
              Instagram
            </a>
          </div>
        </div>

        <!-- YTÜ Huawei Student Developers -->
        <div class="community-home-card community-home-card--light">
          <div class="community-home-logo-box">
            <img
              src="/hsd-logo.png"
              alt="YTÜ Huawei Student Developers"
              class="community-home-logo"
            />
          </div>
          <h3 class="community-home-name">YTÜ Huawei Student Developers</h3>
          <div class="community-home-links">
            <a
              href="https://www.instagram.com/hsd.ytu/"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn community-link-btn--outline"
              aria-label="YTÜ Huawei Student Developers Instagram"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="currentColor"
                  stroke-width="2"></rect>
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"></circle>
              </svg>
              Instagram
            </a>
          </div>
        </div>

        <!-- YTÜ Deptron -->
        <div class="community-home-card community-home-card--light">
          <div class="community-home-logo-box">
            <img
              src="/deptron-logo.jpg"
              alt="YTÜ Deptron"
              class="community-home-logo"
            />
          </div>
          <h3 class="community-home-name">YTÜ Deptron</h3>
          <div class="community-home-links">
            <a
              href="https://www.instagram.com/deptron_robotics/"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn community-link-btn--outline"
              aria-label="YTÜ Deptron Instagram"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="currentColor"
                  stroke-width="2"></rect>
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="2"></circle>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"></circle>
              </svg>
              Instagram
            </a>
            <a
              href="https://deptronrobotics.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="community-link-btn community-link-btn--outline"
              aria-label="YTÜ Deptron Web Sitesi"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
              Web Sitesi
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       ETKİNLİKLER
       ============================================= -->
  <section class="events-home-section" id="etkinlikler">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-chip">Neler Yapıyoruz?</span>
          <h2 class="section-title-lg">Etkinlikler</h2>
        </div>
        <a href="/events" class="btn btn-outline see-more-btn">
          Tümünü Gör
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path
              d="M5 12H19M19 12L13 6M19 12L13 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Tabs -->
      <div class="events-tabs">
        <button class="events-tab active" id="tabUpcoming" data-tab="upcoming"
          >Yaklaşan Etkinlikler</button
        >
        <button class="events-tab" id="tabPast" data-tab="past"
          >Geçmiş Etkinlikler</button
        >
      </div>

      <!-- Upcoming Events Slider -->
      <div class="events-slider-wrapper" id="panelUpcoming">
        <div class="events-slider-container">
          <div class="events-slider" id="eventsSlider">
            <div class="event-home-card event-home-card--featured">
              <div class="event-home-date">
                <span class="event-home-day">23</span>
                <span class="event-home-month">Eki</span>
              </div>
              <div class="event-home-tag">Case Study</div>
              <h3 class="event-home-title">Akbank Case Study</h3>
              <p class="event-home-desc">
                1 günlük fikirleri paylaşma günü — 35.000 TL ödül havuzu.
              </p>
              <div class="event-home-meta">
                📍 Sabancı Center Akbank Genel Müdürlük
              </div>
              <a href="/events" class="btn btn-green event-home-cta"
                >Kayıt Ol →</a
              >
            </div>
          </div>
        </div>

        <div class="slider-nav" style="display: none;">
          <button class="slider-btn" id="eventPrev" aria-label="Önceki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M19 12H5M5 12L11 18M5 12L11 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="slider-dots" id="eventDots">
            <button
              class="slider-dot active"
              data-index="0"
              aria-label="1. etkinlik"></button>
          </div>
          <button class="slider-btn" id="eventNext" aria-label="Sonraki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 12H19M19 12L13 6M19 12L13 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Past Events Slider -->
      <div class="events-slider-wrapper hidden" id="panelPast">
        <div class="events-slider-container">
          <div class="events-slider" id="pastEventsSlider">
            {
              pastEvents.slice(0, 6).map((event) => (
                <div
                  class={`event-home-card ${event.theme === "dark" ? "event-home-card--dark" : event.theme === "green" ? "event-home-card--green" : ""}`}
                >
                  <div
                    class={`past-event-badge ${event.theme === "green" ? "past-event-badge--white" : event.theme !== "dark" ? "past-event-badge--dark" : ""}`}
                  >
                    {event.badge}
                  </div>
                  <h3 class="event-home-title">{event.title}</h3>
                  <p class="event-home-desc">{event.desc}</p>
                  <div
                    class="event-home-meta"
                    style={
                      event.theme === "dark"
                        ? "color:rgba(255,255,255,0.6)"
                        : ""
                    }
                  >
                    📅 {event.date} • 📍 {event.location}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="slider-nav">
          <button class="slider-btn" id="pastPrev" aria-label="Önceki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M19 12H5M5 12L11 18M5 12L11 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="slider-dots" id="pastDots">
            {
              pastEvents
                .slice(0, 6)
                .map((_, i) => (
                  <button
                    class={`slider-dot ${i === 0 ? "active" : ""}`}
                    data-index={i}
                    aria-label={`${i + 1}. etkinlik`}
                  />
                ))
            }
          </div>
          <button class="slider-btn" id="pastNext" aria-label="Sonraki">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 12H19M19 12L13 6M19 12L13 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
