---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Bize Ulaşın — YTU MINT"
  description="YTU MINT ile iletişime geçin. Üyelik başvurusu, sponsorluk veya sorularınız için bize ulaşın."
>

  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title">Bize Ulaşın</h1>
      <p class="page-hero-desc">
        Topluluğumuza katılmak, iş birliği yapmak veya sadece merhaba demek için buradayız.
        En kısa sürede geri döneceğiz.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-inner">

        <!-- Left: Info -->
        <div class="contact-info">
          <h2 class="contact-info-title">Seninle Tanışmaktan<br />Mutluluk Duyarız!</h2>
          <p class="contact-info-desc">
            Matematik, kodlama ve teknolojiye olan ilginizi paylaşmak ya da topluluğumuza katılmak için
            formu doldurun. En kısa sürede geri döneceğiz.
          </p>

          <div class="contact-details">
            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="#191A23" stroke-width="2"/>
                  <polyline points="22,6 12,13 2,6" stroke="#191A23" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">E-posta</div>
                <a href="mailto:mintunity@gmail.com" class="contact-detail-value">mintunity@gmail.com</a>
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="#191A23" stroke-width="2"/>
                  <circle cx="12" cy="10" r="3" stroke="#191A23" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">Adres</div>
                <div class="contact-detail-value">Yıldız Teknik Üniversitesi<br />Davutpaşa Kampüsü, İstanbul</div>
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="#191A23" stroke-width="2"/>
                  <circle cx="9" cy="7" r="4" stroke="#191A23" stroke-width="2"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="#191A23" stroke-width="2"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="#191A23" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">Sosyal Medya</div>
                <div class="contact-social-links">
                  <a href="https://www.instagram.com/ytumint" target="_blank" rel="noopener noreferrer" class="contact-social-link">Instagram</a>
                  <a href="https://www.linkedin.com/company/ytumint" target="_blank" rel="noopener noreferrer" class="contact-social-link">LinkedIn</a>
                  <a href="https://x.com/ytumint" target="_blank" rel="noopener noreferrer" class="contact-social-link">X (Twitter)</a>
                  <a href="https://www.tiktok.com/@ytumint" target="_blank" rel="noopener noreferrer" class="contact-social-link">TikTok</a>
                  <a href="https://www.youtube.com/@mintkulubu" target="_blank" rel="noopener noreferrer" class="contact-social-link">YouTube</a>
                  <a href="https://open.spotify.com/show/0gkaJ9ud28clkg5zWmdnF6?si=eeae0988421348dc&nd=1&dlsi=791e8d082db246da" target="_blank" rel="noopener noreferrer" class="contact-social-link">Spotify</a>
                </div>
              </div>
            </div>
          </div>

          <!-- FAQ -->
          <div class="faq">
            <h3 class="faq-title">Sık Sorulan Sorular</h3>
            <div class="faq-list">
              <details class="faq-item">
                <summary class="faq-question">Üyelik ücretli mi?</summary>
                <div class="faq-answer">Hayır, YTU MINT'e üyelik tamamen ücretsizdir. Herhangi bir ücret talep etmiyoruz.</div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">Herhangi bir bölüm öğrencisi katılabilir mi?</summary>
                <div class="faq-answer">Evet! YTU'nun herhangi bir bölümünden öğrenciler topluluğumuza katılabilir. Matematik ve teknolojiye ilgi duymanız yeterli.</div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">Ne zaman başvurabilirim?</summary>
                <div class="faq-answer">Her dönem başında (Eylül ve Şubat) üye kabulü gerçekleştirilmektedir. Duyurular için sosyal medya hesaplarımızı takip edin.</div>
              </details>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="contact-form-wrapper">
          <form class="contact-form" id="contactForm">
            <div class="radio-group">
              <label>
                <input type="radio" name="tip" value="uye" checked id="radioMember" />
                Üyelik Talebi
              </label>
              <label>
                <input type="radio" name="tip" value="sponsorluk" id="radioSponsor" />
                Sponsorluk
              </label>
              <label>
                <input type="radio" name="tip" value="soru" id="radioQuestion" />
                Soru Sor
              </label>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="contactName">Adınız</label>
                <input type="text" class="form-input" placeholder="Adınız Soyadınız" id="contactName" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="contactEmail">E-posta</label>
                <input type="email" class="form-input" placeholder="ornek@mail.com" id="contactEmail" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contactDept">Bölümünüz</label>
              <input type="text" class="form-input" placeholder="Bölüm ve sınıf bilginiz" id="contactDept" />
            </div>

            <div class="form-group">
              <label class="form-label" for="contactMessage">Mesajınız</label>
              <textarea class="form-input" placeholder="Kendinizden ve ilgi alanlarınızdan bahsedebilirsiniz..." id="contactMessage" required></textarea>
            </div>

            <button type="submit" class="btn btn-dark" style="width: 100%;">Gönder →</button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <script>
    const contactForm = document.getElementById('contactForm');
    contactForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (btn) {
        btn.textContent = '✓ Gönderildi!';
        btn.style.background = 'var(--green)';
        btn.style.color = 'var(--dark)';
        btn.style.borderColor = 'var(--green)';
        setTimeout(() => {
          btn.textContent = 'Gönder →';
          btn.style.background = '';
          btn.style.color = '';
          btn.style.borderColor = '';
          contactForm.reset();
        }, 3000);
      }
    });
  </script>

</Layout>

<style>
  .page-hero {
    padding: 80px 0 60px;
    background: var(--gray);
    border-bottom: 1px solid var(--dark);
  }
  .page-hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    margin-bottom: 20px;
    background: var(--green);
    display: inline-block;
    padding: 0 10px;
    border-radius: 8px;
  }
  .page-hero-desc { font-size: 18px; line-height: 1.7; color: #555; max-width: 640px; margin-top: 16px; }

  .contact-section { padding: 80px 0; }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Left info */
  .contact-info-title { font-size: 32px; font-weight: 600; margin-bottom: 16px; line-height: 1.25; }
  .contact-info-desc { font-size: 17px; color: #555; line-height: 1.7; margin-bottom: 40px; }

  .contact-details { display: flex; flex-direction: column; gap: 28px; margin-bottom: 48px; }
  .contact-detail-item { display: flex; gap: 18px; align-items: flex-start; }
  .contact-detail-icon {
    width: 50px;
    height: 50px;
    background: var(--green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-detail-label { font-size: 13px; color: #888; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
  .contact-detail-value { font-size: 17px; color: var(--dark); line-height: 1.5; text-decoration: none; }
  a.contact-detail-value:hover { text-decoration: underline; }

  .contact-social-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
  .contact-social-link {
    font-size: 15px;
    color: var(--dark);
    text-decoration: underline;
    transition: opacity 0.2s;
  }
  .contact-social-link:hover { opacity: 0.6; }

  /* FAQ */
  .faq-title { font-size: 22px; font-weight: 600; margin-bottom: 20px; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    border: 1px solid var(--dark);
    border-radius: 16px;
    overflow: hidden;
  }
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    background: var(--gray);
    transition: background 0.2s;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after { content: '+'; font-size: 20px; font-weight: 300; }
  details[open] .faq-question { background: var(--green); }
  details[open] .faq-question::after { content: '−'; }
  .faq-answer { padding: 16px 24px; font-size: 15px; line-height: 1.65; color: #555; }

  /* Form */
  .contact-form-wrapper {
    background: var(--gray);
    border: 1px solid var(--dark);
    border-radius: 36px;
    padding: 48px 44px;
    box-shadow: 5px 5px 0 var(--dark);
  }
  .contact-form { display: flex; flex-direction: column; gap: 20px; }
  .radio-group {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .radio-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 16px;
  }
  .radio-group input[type="radio"] {
    width: 22px;
    height: 22px;
    accent-color: var(--dark);
    cursor: pointer;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label { font-size: 15px; font-weight: 500; color: var(--dark); }
  .form-input {
    width: 100%;
    padding: 15px 22px;
    border: 1px solid var(--dark);
    border-radius: 12px;
    font-family: var(--font);
    font-size: 16px;
    background: var(--white);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-input:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(185, 255, 102, 0.35);
  }
  .form-input::placeholder { color: #9A9A9A; }
  textarea.form-input { resize: vertical; min-height: 160px; }

  @media (max-width: 1024px) {
    .contact-inner { grid-template-columns: 1fr; gap: 60px; }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .contact-form-wrapper { padding: 36px 28px; }
    .radio-group { gap: 16px; }
  }
</style>
