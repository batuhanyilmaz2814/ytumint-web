---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Bize Ulaşın | YTÜ MİNT"
  description="YTÜ MİNT ile iletişime geçin. Üyelik başvurusu, sponsorluk veya sorularınız için bize ulaşın."
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title">Bize Ulaşın</h1>
      <p class="page-hero-desc">
        Topluluğumuza katılmak, iş birliği yapmak veya sorularınızı iletmek için
        mesaj bırakabilirsiniz. En kısa sürede geri döneceğiz.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-inner">
        <!-- Left: Info -->
        <div class="contact-info">
          <h2 class="contact-info-title">
            Seninle Tanışmaktan Mutluluk Duyarız
          </h2>
          <p class="contact-info-desc">
            Matematik, yazılım ve teknolojiye olan ilginizi paylaşmak ya da
            topluluğumuza katılmak için formu doldurabilirsiniz.
          </p>

          <div class="contact-details">
            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">E-posta</div>
                <a
                  href="mailto:mintunity@gmail.com"
                  class="contact-detail-value">mintunity@gmail.com</a
                >
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">Adres</div>
                <a
                  href="https://maps.app.goo.gl/ctJrb4M7FvAwWyZj8"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-detail-value"
                >
                  Yıldız Teknik Üniversitesi<br />Davutpaşa Kulüpler Vadisi
                </a>
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="contact-detail-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div>
                <div class="contact-detail-label">Sosyal Medya</div>
                <div class="contact-social-links">
                  <a
                    href="https://www.instagram.com/ytumint"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="Instagram"
                    title="Instagram"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                      ></rect>
                      <circle cx="12" cy="12" r="4"></circle>
                      <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                      ></circle>
                    </svg>
                  </a>
                  <a
                    href="https://www.linkedin.com/company/ytumint"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="LinkedIn"
                    title="LinkedIn"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                      ></path>
                      <rect x="2" y="9" width="4" height="12"></rect>
                      <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                  </a>
                  <a
                    href="https://x.com/ytumint"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="X (Twitter)"
                    title="X (Twitter)"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                      ></path>
                    </svg>
                  </a>
                  <a
                    href="https://www.tiktok.com/@ytumint"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="TikTok"
                    title="TikTok"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                      ></path>
                    </svg>
                  </a>
                  <a
                    href="https://www.youtube.com/@mintkulubu"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="YouTube"
                    title="YouTube"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                      ></path>
                    </svg>
                  </a>
                  <a
                    href="https://open.spotify.com/show/0gkaJ9ud28clkg5zWmdnF6?si=eeae0988421348dc&nd=1&dlsi=791e8d082db246da"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-social-link"
                    aria-label="Spotify"
                    title="Spotify"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.308c-.215.353-.674.464-1.027.249-2.812-1.718-6.353-2.107-10.523-1.154-.403.092-.807-.161-.9-.564-.092-.402.161-.806.564-.899 4.568-1.044 8.489-.6 11.637 1.341.353.215.464.674.249 1.027zm1.47-3.262c-.27.44-.848.577-1.288.307-3.22-1.979-8.128-2.55-11.936-1.393-.497.151-1.024-.134-1.175-.63-.151-.497.134-1.024.63-1.175 4.357-1.322 9.775-.683 13.462 1.583.44.27.577.848.307 1.308zm.126-3.41c-3.86-2.292-10.233-2.503-13.914-1.385-.592.18-1.218-.16-1.398-.752-.18-.592.16-1.218.752-1.398 4.237-1.287 11.272-1.037 15.707 1.597.532.316.705 1.006.389 1.538-.316.533-1.006.706-1.536.4z"
                      ></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="contact-form-wrapper">
          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="contactName"
                  >Adınız Soyadınız</label
                >
                <input
                  type="text"
                  class="form-input"
                  placeholder="Adınız Soyadınız"
                  id="contactName"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="contactEmail">E-posta</label>
                <input
                  type="email"
                  class="form-input"
                  placeholder="ornek@mail.com"
                  id="contactEmail"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contactSubject">Konu</label>
              <input
                type="text"
                class="form-input"
                placeholder="Mesajınızın konusu"
                id="contactSubject"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="contactMessage">Mesajınız</label>
              <textarea
                class="form-input"
                placeholder="Mesajınızı buraya yazabilirsiniz..."
                id="contactMessage"
                rows="5"
                required></textarea>
            </div>

            <button
              type="submit"
              class="btn btn-green"
              style="width: 100%; padding: 14px 20px;">Mesajı Gönder →</button
            >
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const contactForm = document.getElementById("contactForm");
    contactForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      if (btn) {
        btn.textContent = "✓ Gönderildi!";
        btn.style.background = "#61a95d";
        setTimeout(() => {
          btn.textContent = "Mesajı Gönder →";
          btn.style.background = "";
          contactForm.reset();
        }, 3000);
      }
    });
  </script>
</Layout>

<style>
  .page-hero {
    padding: 70px 0 50px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .page-hero-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--dark);
  }
  .page-hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 600px;
  }

  .contact-section {
    padding: 70px 0 90px;
    background: var(--bg-main);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: start;
  }

  /* Left info */
  .contact-info-title {
    font-size: clamp(24px, 2.5vw, 30px);
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.3;
    color: var(--dark);
  }
  .contact-info-desc {
    font-size: 15.5px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 32px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-detail-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .contact-detail-icon {
    width: 42px;
    height: 42px;
    background: var(--green-light);
    color: var(--green-text);
    border: 1px solid var(--green-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-detail-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }
  .contact-detail-value {
    font-size: 15px;
    color: var(--dark);
    line-height: 1.5;
    text-decoration: none;
    font-weight: 500;
  }
  a.contact-detail-value:hover {
    color: var(--green);
  }

  .contact-social-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .contact-social-link {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }
  .contact-social-link:hover {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
    transform: translateY(-2px);
  }

  /* Form */
  .contact-form-wrapper {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    box-shadow: var(--shadow-sm);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--dark);
  }
  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font);
    font-size: 14.5px;
    background: var(--bg-main);
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      background 0.2s;
  }
  .form-input:focus {
    background: var(--white);
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }
  .form-input::placeholder {
    color: #94a3b8;
  }
  textarea.form-input {
    resize: vertical;
    min-height: 120px;
  }

  @media (max-width: 1024px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 640px) {
    .contact-form-wrapper {
      padding: 24px 20px;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
