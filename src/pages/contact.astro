---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://ytumint.org";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Bize Ulaşın | YTÜ MİNT",
  description:
    "YTÜ MİNT ile iletişime geçin. Üyelik başvurusu, sponsorluk veya sorularınız için bize ulaşın.",
  url: `${siteUrl}/contact`,
  mainEntity: {
    "@type": "Organization",
    name: "YTÜ MİNT",
    alternateName: "Multidisipliner İnovasyon Teknolojileri Kulübü",
    url: `${siteUrl}/`,
    logo: `${siteUrl}/brand/mint-logo.webp`,
    email: "mintunity@gmail.com",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Yıldız Teknik Üniversitesi Davutpaşa Kampüsü",
      addressLocality: "Esenler",
      addressRegion: "İstanbul",
      postalCode: "34220",
      addressCountry: "TR",
    },
    sameAs: [
      "https://www.instagram.com/ytumint",
      "https://www.linkedin.com/company/ytumint",
      "https://x.com/ytumint",
      "https://www.tiktok.com/@ytumint",
      "https://www.youtube.com/@mintkulubu",
      "https://open.spotify.com/show/0gkaJ9ud28clkg5zWmdnF6?si=eeae0988421348dc&nd=1&dlsi=791e8d082db246da",
    ],
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "general inquiries",
        email: "mintunity@gmail.com",
        availableLanguage: ["Turkish", "English"],
      },
    ],
  },
};
---

<Layout
  title="Bize Ulaşın | YTÜ MİNT"
  description="YTÜ MİNT ile iletişime geçin. Üyelik başvurusu, sponsorluk veya sorularınız için bize ulaşın."
  keywords="YTÜ MİNT iletişim, kulüp üyelik başvurusu, sponsorluk, YTÜ öğrenci kulübü iletişim, Yıldız Teknik Üniversitesi kulüp kayıt"
  jsonLd={contactJsonLd}
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">Bize Ulaşın</h1>
      </div>
    </div>
  </section>

  <!-- Breadcrumbs -->
  <Breadcrumb currentPage="Bize Ulaşın" />

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-inner">
        <!-- Left: Info Column (Independent Cards) -->
        <div class="contact-info-col">
          <!-- 1. E-posta Card -->
          <div class="contact-detail-item">
            <div class="contact-detail-text">
              <div class="contact-detail-label">E-posta</div>
              <a href="mailto:mintunity@gmail.com" class="contact-detail-value">
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="contact-inline-icon"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>mintunity@gmail.com</span>
              </a>
            </div>
          </div>

          <!-- 2. Sosyal Medya Card -->
          <div class="contact-detail-item contact-detail-item--socials">
            <div class="contact-detail-text">
              <div class="contact-detail-label">Sosyal Medya</div>
              <div class="contact-social-links">
                <a
                  href="https://www.instagram.com/ytumint"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="Instagram"
                  title="Instagram"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                    ></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"
                    ></circle>
                  </svg>
                </a>
                <a
                  href="https://www.linkedin.com/company/ytumint"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="LinkedIn"
                  title="LinkedIn"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                    ></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </a>
                <a
                  href="https://x.com/ytumint"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="X (Twitter)"
                  title="X (Twitter)"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                </a>
                <a
                  href="https://www.tiktok.com/@ytumint"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="TikTok"
                  title="TikTok"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                    ></path>
                  </svg>
                </a>
                <a
                  href="https://www.youtube.com/@mintkulubu"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="YouTube"
                  title="YouTube"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                    ></path>
                  </svg>
                </a>
                <a
                  href="https://open.spotify.com/show/0gkaJ9ud28clkg5zWmdnF6?si=eeae0988421348dc&nd=1&dlsi=791e8d082db246da"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-social-link"
                  aria-label="Spotify"
                  title="Spotify"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.308c-.215.353-.674.464-1.027.249-2.812-1.718-6.353-2.107-10.523-1.154-.403.092-.807-.161-.9-.564-.092-.402.161-.806.564-.899 4.568-1.044 8.489-.6 11.637 1.341.353.215.464.674.249 1.027zm1.47-3.262c-.27.44-.848.577-1.288.307-3.22-1.979-8.128-2.55-11.936-1.393-.497.151-1.024-.134-1.175-.63-.151-.497.134-1.024.63-1.175 4.357-1.322 9.775-.683 13.462 1.583.44.27.577.848.307 1.308zm.126-3.41c-3.86-2.292-10.233-2.503-13.914-1.385-.592.18-1.218-.16-1.398-.752-.18-.592.16-1.218.752-1.398 4.237-1.287 11.272-1.037 15.707 1.597.532.316.705 1.006.389 1.538-.316.533-1.006.706-1.536.4z"
                    ></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- 3. Address & Map Card -->
          <div class="contact-detail-item contact-detail-item--map">
            <div class="contact-detail-text">
              <div class="contact-detail-label">Adres</div>
              <a
                href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x14cabb4ddcbe4005:0x5cecf456e28d1cd1?sa=X&ved=1t:8290&ictx=111&cshid=1787959465848511"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-detail-value"
                title="Google Haritalar'da Aç"
              >
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="contact-inline-icon"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Yıldız Teknik Üniversitesi Davutpaşa Kampüsü</span>
              </a>
            </div>

            <div class="contact-map-wrapper">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3009.9723528256565!2d28.889396176527584!3d41.02584141834241!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cabb4ddcbe4005%3A0x5cecf456e28d1cd1!2zWcSxbGTEsXogVGVrbmlrIMOcbml2ZXJzaXRlc2kgRGF2dXRwYcWfYSBLYW1ww7xzw7w!5e0!3m2!1str!2str!4v1710000000000!5m2!1str!2str"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Yıldız Teknik Üniversitesi Davutpaşa Kampüsü Konumu"
                class="contact-map-iframe"></iframe>
            </div>
          </div>
        </div>

        <!-- Right: Form Card -->
        <div class="contact-card contact-form-card">
          <div class="contact-card-header">
            <h2 class="contact-form-title">Mesaj Gönderin</h2>
          </div>

          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="contactName"
                  >Ad Soyad <span class="form-required">*</span></label
                >
                <input
                  type="text"
                  name="entry.1023753477"
                  class="form-input"
                  placeholder="Adınızı Soyadınızı giriniz"
                  id="contactName"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="contactEmail"
                  >E-posta <span class="form-required">*</span></label
                >
                <input
                  type="email"
                  name="entry.2075415478"
                  class="form-input"
                  placeholder="ornek@mail.com"
                  id="contactEmail"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contactSubject"
                >Konu <span class="form-required">*</span></label
              >
              <select
                class="form-input form-select"
                name="entry.2011797487"
                id="contactSubject"
                required
              >
                <option value="" disabled selected>Konu seçiniz...</option>
                <option value="Genel Bilgi">Genel Bilgi</option>
                <option value="Topluluklar">Topluluklar</option>
                <option value="Sponsorluk & İş Birliği"
                  >Sponsorluk & İş Birliği</option
                >
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="contactMessage"
                >Mesajınız <span class="form-required">*</span></label
              >
              <textarea
                name="entry.760565081"
                class="form-input"
                placeholder="Mesajınızı buraya yazabilirsiniz..."
                id="contactMessage"
                rows="5"
                required></textarea>
            </div>

            <button
              type="submit"
              class="btn btn-green contact-submit-btn"
              id="contactSubmitBtn"
            >
              <span class="btn-text">Gönder</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Toast Notification -->
  <div
    class="toast-notification"
    id="contactToast"
    role="alert"
    aria-live="polite"
  >
    <div class="toast-icon">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <div class="toast-content">
      <div class="toast-title">Mesajınız Başarıyla İletildi!</div>
      <div class="toast-desc">
        En kısa sürede e-posta adresiniz üzerinden geri dönüş yapacağız.
      </div>
    </div>
    <button class="toast-close" id="toastCloseBtn" aria-label="Bildirimi Kapat">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="6"></line>
      </svg>
    </button>
    <div class="toast-progress" id="toastProgress"></div>
  </div>

  <script>
    // Google Form Action URL
    const GOOGLE_FORM_ACTION_URL =
      "https://docs.google.com/forms/d/e/1FAIpQLSdi5i54ppRhgQair9T_vauGmTvS0lnJlOm1jNrUA63qHPa9Zg/formResponse";

    const contactForm = document.getElementById(
      "contactForm",
    ) as HTMLFormElement;
    const submitBtn = document.getElementById(
      "contactSubmitBtn",
    ) as HTMLButtonElement;
    const toast = document.getElementById("contactToast");
    const toastCloseBtn = document.getElementById("toastCloseBtn");
    let toastTimeout: NodeJS.Timeout | number;

    const subjectSelect = document.getElementById(
      "contactSubject",
    ) as HTMLSelectElement;

    function updateSubjectColor() {
      if (subjectSelect) {
        if (!subjectSelect.value) {
          subjectSelect.classList.add("is-placeholder");
        } else {
          subjectSelect.classList.remove("is-placeholder");
        }
      }
    }

    subjectSelect?.addEventListener("change", updateSubjectColor);

    // URL subject query pre-filling
    const urlParams = new URLSearchParams(window.location.search);
    const subjectParam = urlParams.get("subject") || urlParams.get("konu");
    if (subjectParam && subjectSelect) {
      const decoded = decodeURIComponent(subjectParam).toLowerCase();
      for (let i = 0; i < subjectSelect.options.length; i++) {
        const optVal = subjectSelect.options[i].value.toLowerCase();
        if (optVal && (optVal.includes(decoded) || decoded.includes(optVal))) {
          subjectSelect.selectedIndex = i;
          break;
        }
      }
    }

    updateSubjectColor();

    function showToast() {
      if (!toast) return;
      clearTimeout(toastTimeout);
      toast.classList.remove("show");
      void toast.offsetWidth; // Trigger reflow for re-animation
      toast.classList.add("show");

      toastTimeout = setTimeout(() => {
        hideToast();
      }, 5000);
    }

    function hideToast() {
      if (!toast) return;
      toast.classList.remove("show");
      clearTimeout(toastTimeout);
    }

    toastCloseBtn?.addEventListener("click", hideToast);

    contactForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!submitBtn) return;

      // 1. Loading State
      submitBtn.disabled = true;
      submitBtn.classList.add("is-loading");
      submitBtn.innerHTML = `
        <span class="btn-spinner"></span>
        <span>Gönderiliyor...</span>
      `;

      try {
        const formData = new FormData(contactForm);

        // Google Form'a POST isteği gönder (CORS engeline takılmamak için no-cors modu kullanılır)
        await fetch(GOOGLE_FORM_ACTION_URL, {
          method: "POST",
          mode: "no-cors",
          body: formData,
        });

        // Success State
        submitBtn.classList.remove("is-loading");
        submitBtn.classList.add("is-success");
        submitBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Mesajınız İletildi!</span>
        `;

        showToast();
        contactForm.reset();
        updateSubjectColor();

        // 3. Reset Button after 3.5 seconds
        setTimeout(() => {
          submitBtn.classList.remove("is-success");
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span class="btn-text">Gönder</span>`;
        }, 3500);
      } catch (error) {
        console.error("Form gönderim hatası:", error);
        submitBtn.classList.remove("is-loading");
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span class="btn-text">Tekrar Deneyin</span>`;
      }
    });
  </script>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/brand/mint-pattern.webp");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(97, 169, 93, 0.25),
      transparent
    );
    z-index: 1;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  /* Contact Section */
  .contact-section {
    padding: 48px 0 72px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    align-items: stretch;
    position: relative;
    z-index: 1;
    max-width: 1060px;
    margin: 0 auto;
  }

  /* Universal Contact Card (Balanced proportions) */
  .contact-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 30px;
    box-shadow:
      0 2px 12px rgba(15, 23, 42, 0.04),
      0 1px 3px rgba(15, 23, 42, 0.02);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .contact-card-header {
    margin-bottom: 20px;
  }

  .contact-form-title {
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 700;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--dark);
    letter-spacing: -0.01em;
  }

  /* Contact Info Column (Left 3 Separate Cards) */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
  }

  .contact-detail-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    box-shadow:
      0 2px 12px rgba(15, 23, 42, 0.04),
      0 1px 3px rgba(15, 23, 42, 0.02);
    transition: all 0.2s ease;
  }

  .contact-detail-item:hover {
    border-color: rgba(97, 169, 93, 0.35);
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
    transform: translateY(-2px);
  }

  .contact-detail-text {
    width: 100%;
  }

  .contact-detail-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--dark);
    line-height: 1.4;
    text-transform: none;
    margin-bottom: 8px;
  }

  .contact-detail-value {
    font-size: 14px;
    color: var(--dark);
    line-height: 1.45;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.2s ease;
  }

  .contact-inline-icon {
    color: var(--green);
    flex-shrink: 0;
  }

  a.contact-detail-value:hover {
    color: var(--green);
  }

  .contact-social-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 6px;
    align-items: center;
  }

  .contact-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 4px;
    transition:
