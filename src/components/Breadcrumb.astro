---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  currentPage: string;
  parentPages?: BreadcrumbItem[];
}

const { currentPage, parentPages = [] } = Astro.props;

const items: BreadcrumbItem[] = [
  { label: "Ana Sayfa", href: "/" },
  ...parentPages,
  { label: currentPage },
];
---

<nav class="breadcrumb-container" aria-label="İçerik Haritası">
  <div class="container">
    <ol class="breadcrumb-list">
      {
        items.map((item, index) => {
          const isLast = index === items.length - 1;
          return (
            <li class="breadcrumb-item">
              {item.href && !isLast ? (
                <a href={item.href} class="breadcrumb-link">
                  {index === 0 && (
                    <svg
                      class="breadcrumb-home-icon"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                  )}
                  <span>{item.label}</span>
                </a>
              ) : (
                <span class="breadcrumb-current" aria-current="page">
                  {item.label}
                </span>
              )}
              {!isLast && (
                <span class="breadcrumb-separator" aria-hidden="true">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </span>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</nav>

<style>
  .breadcrumb-container {
    width: 100%;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-subtle);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--green);
  }

  .breadcrumb-home-icon {
    opacity: 0.8;
    flex-shrink: 0;
  }

  .breadcrumb-separator {
    display: inline-flex;
    align-items: center;
    color: var(--text-subtle);
    opacity: 0.6;
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .breadcrumb-container {
      padding: 0.65rem 0;
    }
    .breadcrumb-list {
      font-size: 0.78rem;
      gap: 0.35rem;
    }
    .breadcrumb-item {
      gap: 0.35rem;
    }
  }
</style>
