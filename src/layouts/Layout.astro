---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "YTU MINT — Multisipliner İnovasyon Teknolojileri Kulübü",
  description = "YTU MINT — Yıldız Teknik Üniversitesi. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk.",
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/communities", label: "Topluluklarımız" },
  { href: "/events", label: "Etkinliklerimiz" },
  { href: "/team", label: "Ekibimiz" },
];

const footerNavLinks = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/communities", label: "Topluluklarımız" },
  { href: "/events", label: "Etkinliklerimiz" },
  { href: "/team", label: "Ekibimiz" },
  { href: "/contact", label: "Bize Ulaşın" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="container">
        <div class="navbar-inner">
          <a href="/" class="logo">
            <svg
              class="logo-star"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="18" cy="18" r="18" fill="#191A23"></circle>
              <path
                d="M18 6L20.5 15.5L30 18L20.5 20.5L18 30L15.5 20.5L6 18L15.5 15.5L18 6Z"
                fill="#B9FF66"></path>
            </svg>
            <span class="logo-text">YTU MINT</span>
          </a>

          <ul class="nav-links">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "nav-link",
                      { "nav-link--active": isActive(link.href) },
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <button class="hamburger" id="hamburger" aria-label="Menüyü aç">
            <span></span><span></span><span></span>
          </button>

          <a href="/contact" class="btn btn-outline navbar-cta">Bize Ulaşın</a>
        </div>

        <div class="mobile-nav" id="mobileNav">
          <ul class="mobile-nav-links">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "mobile-nav-link",
                      { "mobile-nav-link--active": isActive(link.href) },
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/contact"
                class="btn btn-outline"
                style="margin-top: 10px; width: 100%; text-align: center; justify-content: center; padding: 12px 20px; font-size: 16px; border-radius: 14px;"
              >
                Bize Ulaşın
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-logo logo">
            <svg
              width="34"
              height="34"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="18" cy="18" r="18" fill="#B9FF66"></circle>
              <path
                d="M18 6L20.5 15.5L30 18L20.5 20.5L18 30L15.5 20.5L6 18L15.5 15.5L18 6Z"
                fill="#191A23"></path>
            </svg>
            <span class="logo-text">YTU MINT</span>
          </div>

          <ul class="footer-nav">
            {
              footerNavLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>

          <div class="footer-socials">
            <a href="#" class="footer-social-btn" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                  fill="#191A23"></path>
                <rect x="2" y="9" width="4" height="12" fill="#191A23"></rect>
                <circle cx="4" cy="4" r="2" fill="#191A23"></circle>
              </svg>
            </a>
            <a href="#" class="footer-social-btn" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#191A23">
                <path
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
                ></path>
              </svg>
            </a>
            <a href="#" class="footer-social-btn" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="#191A23"
                  stroke-width="2"></rect>
                <circle cx="12" cy="12" r="4" stroke="#191A23" stroke-width="2"
                ></circle>
                <circle cx="17.5" cy="6.5" r="1.5" fill="#191A23"></circle>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-middle">
          <div class="footer-col">
            <div class="footer-col-title">Hakkımızda</div>
            <p>
              YTU MINT, Yıldız Teknik Üniversitesi bünyesinde matematik, bilişim
              ve teknoloji alanlarında öğrencileri bir araya getiren öğrenci
              topluluğudur.
            </p>
          </div>

          <div class="footer-col">
            <div class="footer-col-title">İletişim</div>
            <address>
              Yıldız Teknik Üniversitesi<br />
              Davutpaşa Kampüsü<br />
              Esenler, İstanbul<br /><br />
              mint@ytu.edu.tr
            </address>
          </div>

          <div class="footer-col">
            <div class="footer-col-title">Bülten</div>
            <p style="margin-bottom: 20px;">
              Etkinlik ve duyurulardan haberdar olmak için bültenimize abone
              olun.
            </p>
            <div class="footer-newsletter">
              <input
                type="email"
                class="form-input"
                placeholder="E-posta adresiniz"
                id="newsletterEmail"
                style="flex:1;"
              />
              <button
                class="btn btn-green"
                style="white-space:nowrap;"
                id="newsletterBtn">Abone Ol</button
              >
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copy">© 2024 YTU MINT. Tüm hakları saklıdır.</p>
          <a href="#" class="footer-policy">Gizlilik Politikası</a>
        </div>
      </div>
    </footer>

    <script>
      // Hamburger menu
      const hamburger = document.getElementById("hamburger");
      const mobileNav = document.getElementById("mobileNav");
      hamburger?.addEventListener("click", () => {
        hamburger.classList.toggle("open");
        mobileNav?.classList.toggle("open");
      });

      // Newsletter
      const newsletterBtn = document.getElementById("newsletterBtn");
      newsletterBtn?.addEventListener("click", () => {
        const email = document.getElementById(
          "newsletterEmail",
        ) as HTMLInputElement;
        if (email?.value) {
          newsletterBtn.textContent = "✓ Abone oldunuz!";
          setTimeout(() => {
            newsletterBtn.textContent = "Abone Ol";
            if (email) email.value = "";
          }, 3000);
        }
      });
    </script>
  </body>
</html>

<style>
  .nav-link {
    text-decoration: none;
    color: var(--dark);
    font-size: 18px;
    transition: opacity 0.2s;
    position: relative;
    padding-bottom: 4px;
  }
  .nav-link:hover {
    opacity: 0.6;
  }
  .nav-link--active {
    font-weight: 600;
  }
  .nav-link--active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
  }

  .navbar-cta {
    padding: 14px 28px;
    font-size: 18px;
    border-radius: 14px;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
    transition: all 0.3s;
  }
  .hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .mobile-nav.open {
    max-height: 500px;
  }
  .mobile-nav-links {
    list-style: none;
    padding: 16px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--gray-mid);
    margin-top: 12px;
  }
  .mobile-nav-link {
    display: block;
    text-decoration: none;
    color: var(--dark);
    font-size: 18px;
    padding: 10px 4px;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .mobile-nav-link:hover {
    background: var(--gray);
  }
  .mobile-nav-link--active {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }
    :global(.nav-links) {
      display: none !important;
    }
    :global(.navbar-cta) {
      display: none !important;
    }
  }
</style>
