            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copy">
            © 2018–{new Date().getFullYear()} YTÜ MİNT. Tüm hakları saklıdır.
          </p>
          <div class="footer-crafted">
            <span>26-27 YK Ekibi tarafından</span>
            <svg
              class="footer-heart"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              ></path>
            </svg>
            <span>ile geliştirildi</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Hamburger menu
      const hamburger = document.getElementById("hamburger");
      const mobileNav = document.getElementById("mobileNav");
      hamburger?.addEventListener("click", () => {
        hamburger.classList.toggle("open");
        mobileNav?.classList.toggle("open");
      });

      // Scroll-based navbar (Only on home page)
      const navbar = document.querySelector(
        ".navbar.navbar--home",
      ) as HTMLElement | null;
      if (navbar) {
        function updateNavbar() {
          if (!navbar) return;
          if (window.scrollY > 40) {
            navbar.classList.add("scrolled");
          } else {
            navbar.classList.remove("scrolled");
          }
        }
        window.addEventListener("scroll", updateNavbar, { passive: true });
        updateNavbar();
      }
    </script>
  </body>
</html>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .navbar-cta {
    padding: 9px 20px;
    font-size: 14px;
    border-radius: var(--radius-full);
  }

  /* Ana Sayfada (Video Hero Üzerinde Şeffafken) */
  :global(.navbar.navbar--home:not(.scrolled)) .nav-link {
    color: rgba(255, 255, 255, 0.8);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .nav-link:hover {
    color: var(--white);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .nav-link--active {
    color: var(--white);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .nav-link--active::after {
    background: var(--green);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .logo-text {
    color: var(--white);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .navbar-cta {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(8px);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .navbar-cta:hover {
    background: var(--white);
    color: var(--dark);
    border-color: var(--white);
  }
  :global(.navbar.navbar--home:not(.scrolled)) .hamburger span {
    background: var(--white);
  }

  /* Hamburger animasyonları */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
    transition: all 0.25s ease;
  }
  .hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menü */
  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .mobile-nav.open {
    max-height: 400px;
  }
  .mobile-nav-links {
    list-style: none;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--border);
    margin-top: 12px;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }
  .mobile-nav-link {
    display: block;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 500;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .mobile-nav-link:hover {
    background: var(--bg-muted);
    color: var(--dark);
  }
  .mobile-nav-link--active {
    font-weight: 600;
    background: var(--green-light);
    color: var(--green-text);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }
    :global(.nav-links) {
      display: none !important;
    }
    :global(.navbar-cta) {
      display: none !important;
    }
  }
</style>
