---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "YTÜ MİNT | Multisipliner İnovasyon Teknolojileri Kulübü",
  description = "YTÜ MİNT | Yıldız Teknik Üniversitesi. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk.",
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/communities", label: "Topluluklarımız" },
  { href: "/events", label: "Etkinliklerimiz" },
  { href: "/team", label: "Ekibimiz" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}

const isHome = currentPath === "/" || currentPath === "";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class:list={["navbar", { "navbar--home": isHome }]}>
      <div class="container">
        <div class="navbar-inner">
          <a href="/" class="logo">
            <svg
              class="logo-star"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="18" cy="18" r="18" fill="#0F172A"></circle>
              <path
                d="M18 6L20.5 15.5L30 18L20.5 20.5L18 30L15.5 20.5L6 18L15.5 15.5L18 6Z"
                fill="#61a95d"></path>
            </svg>
            <span class="logo-text">YTÜ MİNT</span>
          </a>

          <ul class="nav-links">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "nav-link",
                      { "nav-link--active": isActive(link.href) },
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="nav-actions">
            <a href="/contact" class="btn btn-dark navbar-cta">Bize Ulaşın</a>
            <button class="hamburger" id="hamburger" aria-label="Menüyü aç">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>

        <div class="mobile-nav" id="mobileNav">
          <ul class="mobile-nav-links">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "mobile-nav-link",
                      { "mobile-nav-link--active": isActive(link.href) },
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/contact"
                class="btn btn-dark"
                style="margin-top: 10px; width: 100%; text-align: center; justify-content: center; padding: 12px 20px; font-size: 15px;"
              >
                Bize Ulaşın
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand">
            <div class="footer-logos">
              <a href="/" class="footer-logo logo">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 36 36"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle cx="18" cy="18" r="18" fill="#61a95d"></circle>
                  <path
                    d="M18 6L20.5 15.5L30 18L20.5 20.5L18 30L15.5 20.5L6 18L15.5 15.5L18 6Z"
                    fill="#0F172A"></path>
                </svg>
                <span class="logo-text">YTÜ MİNT</span>
              </a>
              <span class="footer-logo-divider" aria-hidden="true"></span>
              <a
                href="https://www.yildiz.edu.tr"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-partner-logo"
                title="Yıldız Teknik Üniversitesi"
                aria-label="Yıldız Teknik Üniversitesi"
              >
                <img
                  src="/ytu-logo.png"
                  alt="Yıldız Teknik Üniversitesi"
