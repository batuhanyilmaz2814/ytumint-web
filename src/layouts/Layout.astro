---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string;
  robots?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = "YTÜ MİNT | Multidisipliner İnovasyon Teknolojileri Kulübü",
  description = "YTÜ MİNT | Yıldız Teknik Üniversitesi. Teknoloji, matematik ve yazılım alanlarında öğrencileri buluşturan topluluk.",
  image = "/brand/mint-wh.jpg",
  type = "website",
  keywords = "YTÜ, MİNT, Yıldız Teknik Üniversitesi, Multidisipliner İnovasyon Teknolojileri, yazılım, teknoloji, öğrenci kulübü, yapay zeka, blockchain, siber güvenlik, inovasyon",
  robots = "index, follow",
  jsonLd,
} = Astro.props;

const cleanPathname =
  Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

const siteBase = Astro.site ?? "https://ytumint.org";
const canonicalURL = new URL(cleanPathname, siteBase);
const ogImageURL = new URL(image, siteBase).href;
const currentPath = cleanPathname;

const navLinks = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/communities", label: "Topluluklarımız" },
  { href: "/events", label: "Etkinliklerimiz" },
  { href: "/team", label: "Ekibimiz" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}

const isHome = currentPath === "/" || currentPath === "";

const pageLabels: Record<string, string> = {
  "/communities": "Topluluklarımız",
  "/events": "Etkinliklerimiz",
  "/team": "Ekibimiz",
  "/contact": "Bize Ulaşın",
};

const currentPageLabel = pageLabels[cleanPathname] || title.split("|")[0].trim();
const hasBreadcrumb = !isHome && cleanPathname !== "/404";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link
      rel="icon"
      type="image/webp"
      sizes="32x32"
      href="/favicons/favicon-32x32.webp"
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="512x512"
      href="/favicons/favicon.webp"
    />
    <link rel="shortcut icon" href="/favicons/favicon.webp" />
    <link rel="apple-touch-icon" href="/favicons/favicon.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="YTÜ MİNT" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#61a95d" />
    <meta name="google-site-verification" content="BZDIF04wGa3fyBWdB8vZEfkYpqachvnTdz7z2kU3MAw" />
    <link rel="alternate" hreflang="tr" href={canonicalURL} />

    <!-- Structured Data: Organization (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "YTÜ MİNT",
        "alternateName": [
          "Yıldız Teknik Üniversitesi MİNT",
          "Multidisipliner İnovasyon Teknolojileri Kulübü"
        ],
        "description": "Yıldız Teknik Üniversitesi teknoloji, inovasyon ve yazılım ekosistemini geleceğe taşıyan multidisipliner öğrenci kulübü.",
        "url": "https://ytumint.org/",
        "logo": "https://ytumint.org/brand/mint-logo.webp",
        "image": "https://ytumint.org/brand/mint-wh.jpg",
        "email": "mintunity@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Yıldız Teknik Üniversitesi Davutpaşa Kampüsü",
          "addressLocality": "Esenler",
          "addressRegion": "İstanbul",
          "postalCode": "34220",
          "addressCountry": "TR"
        },
        "parentOrganization": {
          "@type": "CollegeOrUniversity",
          "name": "Yıldız Teknik Üniversitesi",
          "url": "https://www.yildiz.edu.tr"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "general inquiries",
            "email": "mintunity@gmail.com",
            "availableLanguage": "Turkish"
          }
        ],
        "sameAs": [
          "https://www.instagram.com/ytumint",
          "https://www.linkedin.com/company/ytumint",
          "https://x.com/ytumint",
          "https://www.tiktok.com/@ytumint",
          "https://www.youtube.com/@mintkulubu",
          "https://open.spotify.com/show/0gkaJ9ud28clkg5zWmdnF6?si=eeae0988421348dc&nd=1&dlsi=791e8d082db246da"
        ]
      }
    </script>

    <!-- Structured Data: WebSite (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "YTÜ MİNT",
        "alternateName": [
          "Yıldız Teknik Üniversitesi MİNT",
          "Multidisipliner İnovasyon Teknolojileri Kulübü"
        ],
        "url": "https://ytumint.org/",
        "inLanguage": "tr"
      }
    </script>

    <!-- Structured Data: BreadcrumbList (JSON-LD) -->
    {
      hasBreadcrumb && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Ana Sayfa",
                "item": "https://ytumint.org/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": currentPageLabel,
                "item": canonicalURL.href
              }
            ]
          })}
        />
      )
    }

    <!-- Custom Page Structured Data (JSON-LD) -->
    {
      jsonLd &&
        (Array.isArray(jsonLd) ? (
          jsonLd.map((schema) => (
            <script
              type="application/ld+json"
              is:inline
              set:html={JSON.stringify(schema)}
            />
          ))
        ) : (
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(jsonLd)}
          />
        ))
    }

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={image.endsWith('.png') ? 'image/png' : image.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="YTÜ MİNT" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@ytumint" />
    <meta name="twitter:creator" content="@ytumint" />
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.setAttribute("data-theme", "dark");
      }
      window.localStorage.setItem("theme", theme);
    </script>
  </head>
  <body>
    <nav class:list={["navbar", { "navbar--home": isHome }]}>
      <div class="container">
        <div class="navbar-inner">
          <a href="/" class="logo" aria-label="MİNT Ana Sayfa">
